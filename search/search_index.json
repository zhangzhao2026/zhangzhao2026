{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"tags/","title":"Tags","text":""},{"location":"tags/#tag:tool-mkdocs","title":"tool-mkdocs","text":"<ul> <li>            2026-06-04          </li> <li>            2026-06-05          </li> </ul>"},{"location":"tags/#tag:tool-\u7535\u8111","title":"tool-\u7535\u8111","text":"<ul> <li>            2026-03-29          </li> <li>            2026-04-06          </li> </ul>"},{"location":"2026/01/2026-01-19/","title":"2026-01-19","text":"","boost":1},{"location":"2026/01/2026-01-19/#_1","title":"\u8bb0\u5f55\u6211\u7684\u4e91\u9876\u4e4b\u5f08\u65f6\u5149","text":"<p>\u4e09\u661f\u56db\u8d39\u6700\u591a\u7684\u4e00\u5c40\u2b07\ufe0f</p> <p></p> <p>\u7b2c\u4e00\u6b21\u73a9\u4e09\u661f\u5df4\u5fb7\u6597\u58eb\u9635\u5bb9\u2b07\ufe0f</p> <p></p> <p>\u8d26\u53f7\u7b49\u7ea7431\u65f6\uff0c\u521a\u6253\u4e0a\u94bb\u77f3IV\u2b07\ufe0f</p> <p></p> <p>\u6df7\u8fdb\u6765\u4e00\u5f20\u827e\u6b27\u5c3c\u4e9a\u5c0f\u53f7\u5355\u53cc\u6392\u6700\u9ad8\u6bb5\u4f4d\u2b07\ufe0f</p> <p></p> <p>\u770b\u4e86\u6296\u97f3\u4e91\u9876\u5c0f\u91ce\u9c7c\u7684\u76f4\u64ad\uff0c\u7b2c\u4e00\u6b21\u628a\u4ee5\u5e8f\u5854\u5c14\u9635\u5bb9\u73a9\u6d3b\u2b07\ufe0f</p> <p></p> <p>\u7b2c\u4e00\u6b21\u8131\u79bb\u94bb\u77f3IV\u540e\u5230\u8fbe\u7684\u6700\u9ad8\u6bb5\u4f4d\uff0c\u5728\u6b64\u4e4b\u524d\u4e0a\u4e86\u94bb\u77f3IV\u4e4b\u540e\u6ca1\u8d62\u8fc7\u2b07\ufe0f</p> <p></p> <p>\u5e94\u8be5\u662f\u7b2c\u4e09\u6b21\u5411\u4e0a\u51b2\u5206\u62b5\u8fbe\u7684\u6700\u9ad8\u6bb5\u4f4d\uff0c\u8ddd\u79bb\u8d85\u51e1\u5927\u5e08\u8fd8\u9700\u8981\u8d62\u4e24\u5c40 \uff0c\u53ef\u60dc\u8fd9\u6b21\u5931\u8d25\u4e86\u2b07\ufe0f</p> <p></p> <p>2026\u5e743\u6708\u4efd\uff0c\u4e91\u9876\u4e4b\u5f08\u7ec8\u4e8e\u767b\u4e0a\u8d85\u51e1\u5927\u5e08\u6bb5\u4f4d\u2b07\ufe0f</p> <p></p> <p></p>","boost":1},{"location":"2026/03/2026-03-29/","title":"2026-03-29","text":"","tags":["tool-\u7535\u8111"],"boost":1},{"location":"2026/03/2026-03-29/#0820","title":"08:20","text":"<p>\u7535\u8111\u5c4f\u5e55\u574f\u4e86\uff0c\u7535\u8111\u653e\u5728\u5e8a\u4e0a\u6298\u53e0\u684c\u4e0a\uff0c\u6211\u53bb\u7aef\u5e8a\u5934\u67dc\u4e0a\u521a\u70ae\u7684\u5976\u7c89\u559d\uff0c\u6298\u53e0\u684c\u5012\u4e86\uff0c\u952e\u76d8\u538b\u5230\u7535\u8111\u5c4f\u5e55\u4e4b\u540e\u53d8\u6210\u8fd9\u6837\u5b50\u4e86\u3002</p> <p>\u624b\u91cc\u6ca1\u94b1\uff0c\u8fde\u4e2a\u7535\u8111\u5c4f\u5e55\u90fd\u4e0d\u6562\u4fee\u3002\u73b0\u5728\u53ea\u80fd\u7528\u5916\u63a5\u663e\u793a\u5c4f\uff0c\u628a\u7535\u8111\u5c4f\u5173\u4e86\u4f7f\u7528\u4e86\u3002</p> <p>\u628a 2026-01-19 \u548c 2026-03-12 \u8fd9\u4e24\u7bc7\u7167\u7247\u535a\u5ba2\u8f6c\u79fb\u5230\u8be5\u7ad9\u3002</p>","tags":["tool-\u7535\u8111"],"boost":1},{"location":"2026/03/2026-03-29/#0851","title":"08:51","text":"<p>\u6211\u91cd\u65b0\u5f00\u59cb\u7528 Microsoft To Do \u4e86\uff0c\u627e\u4e86\u4e00\u5708\u8fd8\u662f\u8fd9\u4e2a APP \u7b80\u6d01\u3002\u8fd9\u6b21\u6211\u8981\u6bcf\u5e74\u65b0\u5efa\u4e00\u4e2a\u6587\u4ef6\u5939\u7528\u4f5c\u9879\u76ee\u5f52\u6863\uff0c\u628a\u201c\u5217\u8868\u201d\u5f53\u505a\u9879\u76ee\u5206\u7c7b\uff08\u89c1\u4e0b\u56fe\uff09\u3002</p> <p></p> <p>\u76ee\u524d\u5728\u7528\u6210\u957f\u7c7b\u7684 APP \u5982\u4e0b\uff1a</p> <ul> <li>\u968f\u8bb0\u3001Obsidian\uff1b\u9489\u9489\u6587\u6863\uff1b</li> <li>iBetter\u3001Microsoft To Do\uff1b</li> <li>\u4e13\u6ce8\u3001\u559d\u6c34\u63d0\u9192\u3002</li> </ul> <p>\u76f8\u4fe1\u8fd9\u6b21\u4e00\u5b9a\u80fd\u9760\u7528\u4e0a\u8fd9\u4e9b APP \u8d70\u5411\u4e0a\u5761\u8def\u3002</p>","tags":["tool-\u7535\u8111"],"boost":1},{"location":"2026/03/2026-03-29/#0918","title":"09:18","text":"<p>\u5148\u7ed9\u6587\u4ef6\u5939\u521b\u5230 2035 \u5e74\u2014\u2014\u672a\u6765\u5341\u5e74\uff0c\u4e0d\u7ba1\u7528\u5230\u7528\u4e0d\u5230\uff0c\u7ed9\u81ea\u5df1\u63d0\u4e2a\u9192\uff0c\u8981\u6709\u672a\u6765\u7684\u89c6\u91ce\uff0c\u5411\u8fdc\u5904\u770b\u3002</p> <p>\u63a5\u4e0b\u6765\u6211\u5f97\u603b\u7ed3\u4e00\u4e0b\u5df2\u6709\u7684\u7ecf\u9a8c\uff1a</p> <ul> <li> Android Studio \u65b0\u5efa\u9879\u76ee\u7684\u6d41\u7a0b</li> </ul> <p>\u63a5\u4e0b\u6765\u6211\u60f3\u505a\u7684\u4e8b\uff1a</p> <ul> <li>[-] \u5f00\u53d1 Obsidian \u63d2\u4ef6\uff0c\u7528\u4e8e\u5c06\u6307\u5b9a\u6587\u4ef6\u59391\u7684\u5185\u5bb9\u590d\u5236\u5230\u6307\u5b9a\u6587\u4ef6\u59392<sup>1</sup></li> <li> \u8bbe\u8ba1\u6bcf\u65e5\u5de5\u4f5c\u6d41</li> </ul>","tags":["tool-\u7535\u8111"],"boost":1},{"location":"2026/03/2026-03-29/#1021","title":"10:21","text":"<p>\u53bb\u6751\u91cc\u8001\u4f1a\u8ba1\u7684\u4e08\u592b\u7684\u846c\u793c\u4ed8\u793c\uff0c\u672c\u6253\u7b97\u5728\u90a3\u5403\u5348\u996d\uff0c\u5948\u4f55\u4eba\u592a\u591a\uff0c\u6ca1\u4f4d\u7f6e\u3002\u90fd\u662f\u4e00\u4e2a\u6751\u7684\uff0c\u6211\u4e0d\u60f3\u7ad9\u65c1\u8fb9\u7b49\u3001\u4e5f\u4e0d\u60f3\u7ee7\u7eed\u8d70\u6765\u8d70\u53bb\u627e\u7a7a\u4f4d\uff0c\u4e8e\u662f\u5c31\u56de\u5bb6\u4e86\u3002</p> <p>\u6a21\u4eff\u6211\u5988\u524d\u51e0\u5929\u84b8\u6986\u94b1\u9992\u5934\u7684\u6b65\u9aa4\uff0c\u6211\u81ea\u5df1\u505a\u81ea\u5df1\u5403\u3002\u501f\u7740\u5199\u535a\u5ba2\u7684\u673a\u4f1a\uff0c\u5b66\u4e60\u201c\u6986\u94b1\u201d\u3002</p> <ul> <li>\u6986\u94b1\u662f\u6307\u6986\u94b1\u6811\u7684\u679c\u5b9e\uff0c\u5373\u53ef\u98df\u7528\u7684\u3001\u6241\u5e73\u7684\u5706\u5f62\u6216\u5375\u5f62\u7fc5\u679c\u3002</li> <li>\u6986\u94b1\u5bcc\u542b\u86cb\u767d\u8d28\u3001\u8102\u80aa\u3001\u81b3\u98df\u7ea4\u7ef4\u7b49\u591a\u79cd\u7ef4\u751f\u7d20\u3002</li> <li>\u6986\u94b1\u662f\u4e2d\u56fd\u5317\u65b9\u7684\u6625\u5b63\u4f20\u7edf\u91ce\u83dc\uff0c\u53ef\u4ee5\u84b8\u98df\u3001\u505a\u7ca5\u3001\u5236\u9985\u3002</li> <li>\u6986\u94b1\u5177\u6709\u5065\u813e\u5b89\u795e\u3001\u6b62\u54b3\u5316\u75f0\u3001\u6e05\u70ed\u5229\u6c34\u7684\u529f\u6548\u3002</li> <li>\u6986\u94b1\u662f\u524d\u4eba\u4eec\u95f9\u9965\u8352\u65f6\u7684\u6551\u547d\u98df\u7269\u3002</li> </ul> <p>\u56fe\u7247\u53c2\u8003\uff1a\u6797\u6b4c | \u6986\u94b1\u51ed\u4ec0\u4e48\u8ba9\u6cb3\u5357\u4eba\u60e6\u8bb0\u4e00\u8f88\u5b50\uff1f</p>","tags":["tool-\u7535\u8111"],"boost":1},{"location":"2026/03/2026-03-29/#1157","title":"11:57","text":"<ol> <li>\u4fee\u6539\u4e86 Vs Code \u4e3b\u9898\uff0cPowershell ISE\uff0c\u5b83\u7684\u4f18\u70b9\u662f\u7ec8\u7aef\u4e0e\u6587\u4ef6\u7f16\u8f91\u533a\u57df\u989c\u8272\u5dee\u5f02\u660e\u663e\uff0c\u7701\u773c\u775b\uff1b</li> <li>\u4fee\u6539\u4e86 Vs Code \u5b57\u4f53\uff0c'LXGW WenKai Mono Screen'\uff0c\u73b0\u5728\u7684\u5b83\u66f4\u50cf\u4e00\u4e2a\u6587\u672c\u7f16\u8f91\u5668\uff1b</li> </ol>","tags":["tool-\u7535\u8111"],"boost":1},{"location":"2026/03/2026-03-29/#1245","title":"12:45","text":"<p>\u501f\u52a9 AI\uff0c\u4e3a AutoHotKey \u7684\u4ee3\u7801\u589e\u52a0\u4e86\u6ce8\u91ca\u3001\u89c4\u8303\u5316\u4e86\u90e8\u5206\u7ed3\u6784\u4e0d\u6e05\u6670\u7684\u4ee3\u7801\uff0c\u5e76\u65b0\u589e\u8f93\u51fa\u5f53\u524d\u65f6\u95f4\u3001\u8f93\u51faMarkdown \u516d\u4e2a\u7b49\u7ea7\u7684\u6807\u9898\u7684\u547d\u4ee4\u3002\u73b0\u5728\u5728 Vs Code \u4e2d\u5199\u4f5c\u7684\u4f53\u9a8c\u582a\u6bd4 Obsidian\u3002</p> <p>\u6700\u540e\u5c06 <code>.ahk</code> \u6587\u4ef6\u540c\u6b65\u5230\u575a\u679c\u4e91\u3002</p>","tags":["tool-\u7535\u8111"],"boost":1},{"location":"2026/03/2026-03-29/#1337","title":"13:37","text":"<ul> <li>13:37 \u77e5\u9e1f\u70bc\u91d1\u5bf9\u7ebf\u4e0a\u5355\u5c0f\u706b\u9f99</li> <li>14:24 \u6253\u4e86\u4e24\u5c40\u82f1\u96c4\u8054\u76df\u5339\u914d\u6a21\u5f0f\uff0c\u88ab\u66b4\u63cd\u3002</li> </ul>","tags":["tool-\u7535\u8111"],"boost":1},{"location":"2026/03/2026-03-29/#1500","title":"15:00","text":"<p>\u6211\u89c9\u5f97\u8fd9\u662f\u6211\u5f53\u524d\u4eba\u751f\u9636\u6bb5\u6700\u91cd\u8981\u7684\u65f6\u523b\uff0c\u5728\u6211\u6253\u5b8c\u82f1\u96c4\u8054\u76df\uff0c\u6253\u5f00 bilibili \u76f4\u64ad\u9875\u9762\uff0c\u9996\u9875\u63a8\u9001\u7684\u662f\u4e2d\u592e\u65b0\u95fb\u536b\u89c6\u3002\u6b63\u5728\u64ad\u653e\u7684\u662f OpenClaw \u76f8\u5173\u7684\u65b0\u95fb\uff0c\u8bb0\u8005\u91c7\u8bbf\u4e86\u591a\u884c\u591a\u4e1a\u7684\u6b63\u5728\u4f7f\u7528 OpenClaw \u7684\u4eba\uff0c\u6211\u8ba4\u4e3a\u6211\u5e94\u5f53\u6210\u4e3a\u4ed6\u4eec\u4e2d\u7684\u4e00\u5458\u3002</p> <p>\u6211\u4e00\u8fb9\u542c\u7740\u65b0\u95fb\uff0c\u4e00\u8fb9\u5411\u8c46\u5305\u8bf7\u6559\u5982\u4f55\u5b89\u88c5\u9f99\u867e\u3002</p> <ol> <li> <p>2026-06-05 \u7559\u8a00\uff1a\u5f53\u521d\u4f60\u521b\u5efa\u8be5\u8ba1\u5212\u7684\u76ee\u6807\u662f\u4ec0\u4e48\uff1f\u5982\u4eca\u6211\u770b\u4e0d\u5230\u8fd9\u4e2a\u63d2\u4ef6\u6709\u4f55\u5e94\u7528\u573a\u666f\u3002\u00a0\u21a9</p> </li> </ol>","tags":["tool-\u7535\u8111"],"boost":1},{"location":"2026/06/2026-06-05/","title":"2026-06-05","text":"<p>11:49 \u6211\u603b\u7ed3\u4e86mkdocs\u4e2d\u5f15\u7528\u5176\u4ed6\u6587\u4ef6\u7684\u8def\u5f84\u600e\u4e48\u586b\uff0c\u7b14\u8bb0\u540c\u65f6\u4fdd\u5b58\u5728\u672cMkdocs\u535a\u5ba2\u7684\u8bed\u6cd5\u8bf4\u660e\u4e66\u548cObsidian\u7684\u5361\u7247\u76d2\u5e93\u4e2d\u3002\u8d77\u521d\u6211\u628a\u7b14\u8bb0\u4fdd\u5b58\u5728\u5f53\u524d\u6587\u4ef6\u4e2d\uff0c\u4f46\u662f\u672c\u7ad9\u7684\u521d\u8877\u662f\u8bb0\u5f55\u6211\u7684\u788e\u788e\u5ff5\uff08\u505a\u4e86\u4ec0\u4e48\u3001\u60f3\u4e86\u4ec0\u4e48\uff09\uff0c\u5982\u679c\u628a\u6280\u672f\u7b14\u8bb0\u7275\u626f\u8fdb\u6765\uff0c\u53ef\u80fd\u8fc7\u4e0d\u4e86\u4e24\u5929\uff0c\u6211\u5c31\u4e0d\u60f3\u6253\u5f00VS Code\u4e0eObsidian\u66f4\u65b0\u535a\u5ba2\u4e86\u3002\u6240\u4ee5\u6211\u5c06\u7b14\u8bb0\u8f6c\u79fb\u5230\u4e86<code>../../../Instructions/\u8bed\u6cd5\u8bf4\u660e\u4e66.md</code><sup>1</sup>\u4e2d\uff0c\u5e76\u5728\u6b64\u7b80\u8981\u8bf4\u660e\u4e8b\u60c5\u7684\u53d1\u5c55\u8fc7\u7a0b\u3002</p> <ul> <li> 13:06 \u5b66\u4e60Mkdocs-material\u4e3b\u9898\u7684\u6807\u6ce8\u5757\u8bed\u6cd5\uff0c\u5e76\u5728\u9996\u9875<code>index.md</code>\u5b9e\u8df5</li> <li> 13:32 \u7cbe\u7b80\u9996\u9875\u5185\u5bb9\uff0c\u6b21\u8981\u5185\u5bb9\u8f6c\u79fb\u5230<code>Instructions</code>\u76ee\u5f55</li> </ul> <p>\u4e4b\u524d\u5728LOL\u97e9\u670d\u738b\u8005\u5bf9\u5c40\u89c6\u9891\u4e2d\u770b\u5230\u4e86\u4e0b\u8def\u63d0\u83ab\uff0c\u51fa\u7535\u5200\u3002\u524d\u4e24\u5929\u5fd9\u7740\u6536\u5c0f\u9ea6\uff0c\u665a\u4e0a\u6211\u4f1a\u73a9\u51e0\u4e2a\u5c0f\u65f6LOL\uff0c\u9047\u89c1\u4e00\u4e2a\u4e0a\u5355\u63d0\u83ab\uff0c\u4e5f\u51fa\u7535\u5200\u3002\u4eca\u5929\u770b\u54b8\u9c7c\u6e38\u8361\u5728\u8349\u539f\u513f\u76f4\u64ad\u4f7f\u7528\u5361\u8389\u65af\u5854\uff0c\u4e5f\u51fa\u7535\u5200\u3002\u4e8e\u662f\u6211\u63a8\u6d4b\u8fd9\u4ef6\u88c5\u5907\u5e94\u662f\u6539\u7248\u4e86\uff0c\u65b0\u589e\u4e86\u5bf9\u5f39\u5c04\u76ee\u6807\u9644\u52a0\u653b\u51fb\u7279\u6548\u7684\u7279\u6027\u3002</p> <p>\u7ecf\u8fc7\u641c\u7d22\uff0c\u57284\u670828\u53f7\u768426.9\u7248\u672c\u516c\u544a\u4e2d\u627e\u5230\u4e86\u76f8\u5173\u8bf4\u660e\u3002\u539f\u67654\u6708\u4efd\u5c31\u6539\u7248\u4e86\u5462\uff0c\u770b\u6765\u62115\u6708\u4efd\u5f88\u5c11\u73a9\u6e38\u620f\u3002</p> <ul> <li> 16:04~16:27 \u4e3a\u672c\u535a\u5ba2\u672c\u5730\u6587\u4ef6\u521b\u5efa\u4e86<code>.bat</code>\u548c<code>.vbs</code>\u6587\u4ef6<sup>2</sup>\u3002</li> </ul> <ol> <li> <p>\u8be5\u6587\u4ef6\u4e0d\u5728<code>docs</code>\u76ee\u5f55\u4e0b\uff0c\u4e0d\u4f1a\u88abmkdocs\u6e32\u67d3\u3002\u00a0\u21a9</p> </li> <li> <p>\u533a\u522b\uff1a\u524d\u8005\u6709cmd\u7a97\u53e3\uff0c\u53ef\u67e5\u770b\u62a5\u9519\u4fe1\u606f\uff1b\u540e\u8005\u65e0cmd\u7a97\u53e3\uff0c\u4f46\u4e0d\u53ef\u4ee5\u67e5\u770b\u62a5\u9519\u3002\u00a0\u21a9</p> </li> </ol>","tags":["tool-mkdocs"],"boost":1}]}