{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"tags/","title":"Tags","text":""},{"location":"tags/#tag:life-\u56fe\u7247\u6545\u4e8b","title":"life-\u56fe\u7247\u6545\u4e8b","text":"<ul> <li>            2026-06-06          </li> </ul>"},{"location":"tags/#tag:tool-mkdocs","title":"tool-mkdocs","text":"<ul> <li>            2026-06-04          </li> <li>            2026-06-05          </li> <li>            2026-06-06          </li> <li>            2026-06-07          </li> <li>            2026-06-08          </li> </ul>"},{"location":"tags/#tag:tool-\u7535\u8111","title":"tool-\u7535\u8111","text":"<ul> <li>            2026-03-29          </li> <li>            2026-04-06          </li> </ul>"},{"location":"2026/01/2026-01-19/","title":"2026-01-19","text":"","boost":1},{"location":"2026/01/2026-01-19/#_1","title":"\u8bb0\u5f55\u6211\u7684\u4e91\u9876\u4e4b\u5f08\u65f6\u5149","text":"<p>\u4e09\u661f\u56db\u8d39\u6700\u591a\u7684\u4e00\u5c40\u2b07\ufe0f</p> <p></p> <p>\u7b2c\u4e00\u6b21\u73a9\u4e09\u661f\u5df4\u5fb7\u6597\u58eb\u9635\u5bb9\u2b07\ufe0f</p> <p></p> <p>\u8d26\u53f7\u7b49\u7ea7431\u65f6\uff0c\u521a\u6253\u4e0a\u94bb\u77f3IV\u2b07\ufe0f</p> <p></p> <p>\u6df7\u8fdb\u6765\u4e00\u5f20\u827e\u6b27\u5c3c\u4e9a\u5c0f\u53f7\u5355\u53cc\u6392\u6700\u9ad8\u6bb5\u4f4d\u2b07\ufe0f</p> <p></p> <p>\u770b\u4e86\u6296\u97f3\u4e91\u9876\u5c0f\u91ce\u9c7c\u7684\u76f4\u64ad\uff0c\u7b2c\u4e00\u6b21\u628a\u4ee5\u5e8f\u5854\u5c14\u9635\u5bb9\u73a9\u6d3b\u2b07\ufe0f</p> <p></p> <p>\u7b2c\u4e00\u6b21\u8131\u79bb\u94bb\u77f3IV\u540e\u5230\u8fbe\u7684\u6700\u9ad8\u6bb5\u4f4d\uff0c\u5728\u6b64\u4e4b\u524d\u4e0a\u4e86\u94bb\u77f3IV\u4e4b\u540e\u6ca1\u8d62\u8fc7\u2b07\ufe0f</p> <p></p> <p>\u5e94\u8be5\u662f\u7b2c\u4e09\u6b21\u5411\u4e0a\u51b2\u5206\u62b5\u8fbe\u7684\u6700\u9ad8\u6bb5\u4f4d\uff0c\u8ddd\u79bb\u8d85\u51e1\u5927\u5e08\u8fd8\u9700\u8981\u8d62\u4e24\u5c40 \uff0c\u53ef\u60dc\u8fd9\u6b21\u5931\u8d25\u4e86\u2b07\ufe0f</p> <p></p> <p>2026\u5e743\u6708\u4efd\uff0c\u4e91\u9876\u4e4b\u5f08\u7ec8\u4e8e\u767b\u4e0a\u8d85\u51e1\u5927\u5e08\u6bb5\u4f4d\u2b07\ufe0f</p> <p></p> <p></p>","boost":1},{"location":"2026/03/2026-03-29/","title":"2026-03-29","text":"","tags":["tool-\u7535\u8111"],"boost":1},{"location":"2026/03/2026-03-29/#0820","title":"08:20","text":"<p>\u7535\u8111\u5c4f\u5e55\u574f\u4e86\uff0c\u7535\u8111\u653e\u5728\u5e8a\u4e0a\u6298\u53e0\u684c\u4e0a\uff0c\u6211\u53bb\u7aef\u5e8a\u5934\u67dc\u4e0a\u521a\u70ae\u7684\u5976\u7c89\u559d\uff0c\u6298\u53e0\u684c\u5012\u4e86\uff0c\u952e\u76d8\u538b\u5230\u7535\u8111\u5c4f\u5e55\u4e4b\u540e\u53d8\u6210\u8fd9\u6837\u5b50\u4e86\u3002</p> <p>\u624b\u91cc\u6ca1\u94b1\uff0c\u8fde\u4e2a\u7535\u8111\u5c4f\u5e55\u90fd\u4e0d\u6562\u4fee\u3002\u73b0\u5728\u53ea\u80fd\u7528\u5916\u63a5\u663e\u793a\u5c4f\uff0c\u628a\u7535\u8111\u5c4f\u5173\u4e86\u4f7f\u7528\u4e86\u3002</p> <p>\u628a 2026-01-19 \u548c 2026-03-12 \u8fd9\u4e24\u7bc7\u7167\u7247\u535a\u5ba2\u8f6c\u79fb\u5230\u8be5\u7ad9\u3002</p>","tags":["tool-\u7535\u8111"],"boost":1},{"location":"2026/03/2026-03-29/#0851","title":"08:51","text":"<p>\u6211\u91cd\u65b0\u5f00\u59cb\u7528 Microsoft To Do \u4e86\uff0c\u627e\u4e86\u4e00\u5708\u8fd8\u662f\u8fd9\u4e2a APP \u7b80\u6d01\u3002\u8fd9\u6b21\u6211\u8981\u6bcf\u5e74\u65b0\u5efa\u4e00\u4e2a\u6587\u4ef6\u5939\u7528\u4f5c\u9879\u76ee\u5f52\u6863\uff0c\u628a\u201c\u5217\u8868\u201d\u5f53\u505a\u9879\u76ee\u5206\u7c7b\uff08\u89c1\u4e0b\u56fe\uff09\u3002</p> <p></p> <p>\u76ee\u524d\u5728\u7528\u6210\u957f\u7c7b\u7684 APP \u5982\u4e0b\uff1a</p> <ul> <li>\u968f\u8bb0\u3001Obsidian\uff1b\u9489\u9489\u6587\u6863\uff1b</li> <li>iBetter\u3001Microsoft To Do\uff1b</li> <li>\u4e13\u6ce8\u3001\u559d\u6c34\u63d0\u9192\u3002</li> </ul> <p>\u76f8\u4fe1\u8fd9\u6b21\u4e00\u5b9a\u80fd\u9760\u7528\u4e0a\u8fd9\u4e9b APP \u8d70\u5411\u4e0a\u5761\u8def\u3002</p>","tags":["tool-\u7535\u8111"],"boost":1},{"location":"2026/03/2026-03-29/#0918","title":"09:18","text":"<p>\u5148\u7ed9\u6587\u4ef6\u5939\u521b\u5230 2035 \u5e74\u2014\u2014\u672a\u6765\u5341\u5e74\uff0c\u4e0d\u7ba1\u7528\u5230\u7528\u4e0d\u5230\uff0c\u7ed9\u81ea\u5df1\u63d0\u4e2a\u9192\uff0c\u8981\u6709\u672a\u6765\u7684\u89c6\u91ce\uff0c\u5411\u8fdc\u5904\u770b\u3002</p> <p>\u63a5\u4e0b\u6765\u6211\u5f97\u603b\u7ed3\u4e00\u4e0b\u5df2\u6709\u7684\u7ecf\u9a8c\uff1a</p> <ul> <li> Android Studio \u65b0\u5efa\u9879\u76ee\u7684\u6d41\u7a0b</li> </ul> <p>\u63a5\u4e0b\u6765\u6211\u60f3\u505a\u7684\u4e8b\uff1a</p> <ul> <li>[-] \u5f00\u53d1 Obsidian \u63d2\u4ef6\uff0c\u7528\u4e8e\u5c06\u6307\u5b9a\u6587\u4ef6\u59391\u7684\u5185\u5bb9\u590d\u5236\u5230\u6307\u5b9a\u6587\u4ef6\u59392<sup>1</sup></li> <li> \u8bbe\u8ba1\u6bcf\u65e5\u5de5\u4f5c\u6d41</li> </ul>","tags":["tool-\u7535\u8111"],"boost":1},{"location":"2026/03/2026-03-29/#1021","title":"10:21","text":"<p>\u53bb\u6751\u91cc\u8001\u4f1a\u8ba1\u7684\u4e08\u592b\u7684\u846c\u793c\u4ed8\u793c\uff0c\u672c\u6253\u7b97\u5728\u90a3\u5403\u5348\u996d\uff0c\u5948\u4f55\u4eba\u592a\u591a\uff0c\u6ca1\u4f4d\u7f6e\u3002\u90fd\u662f\u4e00\u4e2a\u6751\u7684\uff0c\u6211\u4e0d\u60f3\u7ad9\u65c1\u8fb9\u7b49\u3001\u4e5f\u4e0d\u60f3\u7ee7\u7eed\u8d70\u6765\u8d70\u53bb\u627e\u7a7a\u4f4d\uff0c\u4e8e\u662f\u5c31\u56de\u5bb6\u4e86\u3002</p> <p>\u6a21\u4eff\u6211\u5988\u524d\u51e0\u5929\u84b8\u6986\u94b1\u9992\u5934\u7684\u6b65\u9aa4\uff0c\u6211\u81ea\u5df1\u505a\u81ea\u5df1\u5403\u3002\u501f\u7740\u5199\u535a\u5ba2\u7684\u673a\u4f1a\uff0c\u5b66\u4e60\u201c\u6986\u94b1\u201d\u3002</p> <ul> <li>\u6986\u94b1\u662f\u6307\u6986\u94b1\u6811\u7684\u679c\u5b9e\uff0c\u5373\u53ef\u98df\u7528\u7684\u3001\u6241\u5e73\u7684\u5706\u5f62\u6216\u5375\u5f62\u7fc5\u679c\u3002</li> <li>\u6986\u94b1\u5bcc\u542b\u86cb\u767d\u8d28\u3001\u8102\u80aa\u3001\u81b3\u98df\u7ea4\u7ef4\u7b49\u591a\u79cd\u7ef4\u751f\u7d20\u3002</li> <li>\u6986\u94b1\u662f\u4e2d\u56fd\u5317\u65b9\u7684\u6625\u5b63\u4f20\u7edf\u91ce\u83dc\uff0c\u53ef\u4ee5\u84b8\u98df\u3001\u505a\u7ca5\u3001\u5236\u9985\u3002</li> <li>\u6986\u94b1\u5177\u6709\u5065\u813e\u5b89\u795e\u3001\u6b62\u54b3\u5316\u75f0\u3001\u6e05\u70ed\u5229\u6c34\u7684\u529f\u6548\u3002</li> <li>\u6986\u94b1\u662f\u524d\u4eba\u4eec\u95f9\u9965\u8352\u65f6\u7684\u6551\u547d\u98df\u7269\u3002</li> </ul> <p>\u56fe\u7247\u53c2\u8003\uff1a\u6797\u6b4c | \u6986\u94b1\u51ed\u4ec0\u4e48\u8ba9\u6cb3\u5357\u4eba\u60e6\u8bb0\u4e00\u8f88\u5b50\uff1f</p>","tags":["tool-\u7535\u8111"],"boost":1},{"location":"2026/03/2026-03-29/#1157","title":"11:57","text":"<ol> <li>\u4fee\u6539\u4e86 Vs Code \u4e3b\u9898\uff0cPowershell ISE\uff0c\u5b83\u7684\u4f18\u70b9\u662f\u7ec8\u7aef\u4e0e\u6587\u4ef6\u7f16\u8f91\u533a\u57df\u989c\u8272\u5dee\u5f02\u660e\u663e\uff0c\u7701\u773c\u775b\uff1b</li> <li>\u4fee\u6539\u4e86 Vs Code \u5b57\u4f53\uff0c'LXGW WenKai Mono Screen'\uff0c\u73b0\u5728\u7684\u5b83\u66f4\u50cf\u4e00\u4e2a\u6587\u672c\u7f16\u8f91\u5668\uff1b</li> </ol>","tags":["tool-\u7535\u8111"],"boost":1},{"location":"2026/03/2026-03-29/#1245","title":"12:45","text":"<p>\u501f\u52a9 AI\uff0c\u4e3a AutoHotKey \u7684\u4ee3\u7801\u589e\u52a0\u4e86\u6ce8\u91ca\u3001\u89c4\u8303\u5316\u4e86\u90e8\u5206\u7ed3\u6784\u4e0d\u6e05\u6670\u7684\u4ee3\u7801\uff0c\u5e76\u65b0\u589e\u8f93\u51fa\u5f53\u524d\u65f6\u95f4\u3001\u8f93\u51faMarkdown \u516d\u4e2a\u7b49\u7ea7\u7684\u6807\u9898\u7684\u547d\u4ee4\u3002\u73b0\u5728\u5728 Vs Code \u4e2d\u5199\u4f5c\u7684\u4f53\u9a8c\u582a\u6bd4 Obsidian\u3002</p> <p>\u6700\u540e\u5c06 <code>.ahk</code> \u6587\u4ef6\u540c\u6b65\u5230\u575a\u679c\u4e91\u3002</p>","tags":["tool-\u7535\u8111"],"boost":1},{"location":"2026/03/2026-03-29/#1337","title":"13:37","text":"<ul> <li>13:37 \u77e5\u9e1f\u70bc\u91d1\u5bf9\u7ebf\u4e0a\u5355\u5c0f\u706b\u9f99</li> <li>14:24 \u6253\u4e86\u4e24\u5c40\u82f1\u96c4\u8054\u76df\u5339\u914d\u6a21\u5f0f\uff0c\u88ab\u66b4\u63cd\u3002</li> </ul>","tags":["tool-\u7535\u8111"],"boost":1},{"location":"2026/03/2026-03-29/#1500","title":"15:00","text":"<p>\u6211\u89c9\u5f97\u8fd9\u662f\u6211\u5f53\u524d\u4eba\u751f\u9636\u6bb5\u6700\u91cd\u8981\u7684\u65f6\u523b\uff0c\u5728\u6211\u6253\u5b8c\u82f1\u96c4\u8054\u76df\uff0c\u6253\u5f00 bilibili \u76f4\u64ad\u9875\u9762\uff0c\u9996\u9875\u63a8\u9001\u7684\u662f\u4e2d\u592e\u65b0\u95fb\u536b\u89c6\u3002\u6b63\u5728\u64ad\u653e\u7684\u662f OpenClaw \u76f8\u5173\u7684\u65b0\u95fb\uff0c\u8bb0\u8005\u91c7\u8bbf\u4e86\u591a\u884c\u591a\u4e1a\u7684\u6b63\u5728\u4f7f\u7528 OpenClaw \u7684\u4eba\uff0c\u6211\u8ba4\u4e3a\u6211\u5e94\u5f53\u6210\u4e3a\u4ed6\u4eec\u4e2d\u7684\u4e00\u5458\u3002</p> <p>\u6211\u4e00\u8fb9\u542c\u7740\u65b0\u95fb\uff0c\u4e00\u8fb9\u5411\u8c46\u5305\u8bf7\u6559\u5982\u4f55\u5b89\u88c5\u9f99\u867e\u3002</p> <ol> <li> <p>2026-06-05 \u7559\u8a00\uff1a\u5f53\u521d\u4f60\u521b\u5efa\u8be5\u8ba1\u5212\u7684\u76ee\u6807\u662f\u4ec0\u4e48\uff1f\u5982\u4eca\u6211\u770b\u4e0d\u5230\u8fd9\u4e2a\u63d2\u4ef6\u6709\u4f55\u5e94\u7528\u573a\u666f\u3002\u00a0\u21a9</p> </li> </ol>","tags":["tool-\u7535\u8111"],"boost":1},{"location":"2026/06/2026-06-05/","title":"2026-06-05","text":"<p>11:49 \u6211\u603b\u7ed3\u4e86mkdocs\u4e2d\u5f15\u7528\u5176\u4ed6\u6587\u4ef6\u7684\u8def\u5f84\u600e\u4e48\u586b\uff0c\u7b14\u8bb0\u540c\u65f6\u4fdd\u5b58\u5728\u672cMkdocs\u535a\u5ba2\u7684\u8bed\u6cd5\u8bf4\u660e\u4e66\u548cObsidian\u7684\u5361\u7247\u76d2\u5e93\u4e2d\u3002\u8d77\u521d\u6211\u628a\u7b14\u8bb0\u4fdd\u5b58\u5728\u5f53\u524d\u6587\u4ef6\u4e2d\uff0c\u4f46\u662f\u672c\u7ad9\u7684\u521d\u8877\u662f\u8bb0\u5f55\u6211\u7684\u788e\u788e\u5ff5\uff08\u505a\u4e86\u4ec0\u4e48\u3001\u60f3\u4e86\u4ec0\u4e48\uff09\uff0c\u5982\u679c\u628a\u6280\u672f\u7b14\u8bb0\u7275\u626f\u8fdb\u6765\uff0c\u53ef\u80fd\u8fc7\u4e0d\u4e86\u4e24\u5929\uff0c\u6211\u5c31\u4e0d\u60f3\u6253\u5f00VS Code\u4e0eObsidian\u66f4\u65b0\u535a\u5ba2\u4e86\u3002\u6240\u4ee5\u6211\u5c06\u7b14\u8bb0\u8f6c\u79fb\u5230\u4e86<code>../../../Instructions/\u8bed\u6cd5\u8bf4\u660e\u4e66.md</code><sup>1</sup>\u4e2d\uff0c\u5e76\u5728\u6b64\u7b80\u8981\u8bf4\u660e\u4e8b\u60c5\u7684\u53d1\u5c55\u8fc7\u7a0b\u3002</p> <ul> <li> 13:06 \u5b66\u4e60Mkdocs-material\u4e3b\u9898\u7684\u6807\u6ce8\u5757\u8bed\u6cd5\uff0c\u5e76\u5728\u9996\u9875<code>index.md</code>\u5b9e\u8df5</li> <li> 13:32 \u7cbe\u7b80\u9996\u9875\u5185\u5bb9\uff0c\u6b21\u8981\u5185\u5bb9\u8f6c\u79fb\u5230<code>Instructions</code>\u76ee\u5f55</li> </ul> <p>\u4e4b\u524d\u5728LOL\u97e9\u670d\u738b\u8005\u5bf9\u5c40\u89c6\u9891\u4e2d\u770b\u5230\u4e86\u4e0b\u8def\u63d0\u83ab\uff0c\u51fa\u7535\u5200\u3002\u524d\u4e24\u5929\u5fd9\u7740\u6536\u5c0f\u9ea6\uff0c\u665a\u4e0a\u6211\u4f1a\u73a9\u51e0\u4e2a\u5c0f\u65f6LOL\uff0c\u9047\u89c1\u4e00\u4e2a\u4e0a\u5355\u63d0\u83ab\uff0c\u4e5f\u51fa\u7535\u5200\u3002\u4eca\u5929\u770b\u54b8\u9c7c\u6e38\u8361\u5728\u8349\u539f\u513f\u76f4\u64ad\u4f7f\u7528\u5361\u8389\u65af\u5854\uff0c\u4e5f\u51fa\u7535\u5200\u3002\u4e8e\u662f\u6211\u63a8\u6d4b\u8fd9\u4ef6\u88c5\u5907\u5e94\u662f\u6539\u7248\u4e86\uff0c\u65b0\u589e\u4e86\u5bf9\u5f39\u5c04\u76ee\u6807\u9644\u52a0\u653b\u51fb\u7279\u6548\u7684\u7279\u6027\u3002</p> <p>\u7ecf\u8fc7\u641c\u7d22\uff0c\u57284\u670828\u53f7\u768426.9\u7248\u672c\u516c\u544a\u4e2d\u627e\u5230\u4e86\u76f8\u5173\u8bf4\u660e\u3002\u539f\u67654\u6708\u4efd\u5c31\u6539\u7248\u4e86\u5462\uff0c\u770b\u6765\u62115\u6708\u4efd\u5f88\u5c11\u73a9\u6e38\u620f\u3002</p> <ul> <li> 16:04~16:27 \u4e3a\u672c\u535a\u5ba2\u672c\u5730\u6587\u4ef6\u521b\u5efa\u4e86<code>.bat</code>\u548c<code>.vbs</code>\u6587\u4ef6<sup>2</sup>\u3002</li> <li> 16:55 \u5728\u8fd0\u884c\u548c\u7ec8\u6b62mkdocs serve\u670d\u52a1\u7684<code>.vbs</code>\u6587\u4ef6\u57fa\u7840\u4e0a\uff0c\u65b0\u589e\u4e86\u4e00\u4e2a\u6784\u5efa<code>mkdocs bulid</code>\u5e76\u5c06\u7f51\u7ad9\u6587\u4ef6\u79fb\u52a8\u5230\u672c\u5730Github\u4ed3\u5e93\u7684<code>.vbs</code>\u6587\u4ef6\u3002</li> <li> 17:07 \u641e\u6e05\u695a\u4e86\u300cObsidian \u7684 File Explorer Note Count \u63d2\u4ef6\u7684 Filter List \u300d\u529f\u80fd</li> </ul> <p>\u770b\u4e86\u4e00\u4e2a\u89c6\u9891\uff1a\u3010\u65b0\u624b\u5fc5\u5b66\u3011Obsidian\u8fd9\u4e2a\u5806\u53e0\u529f\u80fd\uff0c\u85cf\u5f97\u591f\u6df1\u5440\uff01\u3002</p> <p>\u6211\u7559\u8a00</p> <p>\u6211\u5f53\u5e74\u521a\u7528Obsidian\uff0c\u51e0\u4e4e\u6bcf\u4e2a\u4ecb\u7ecdObsidian\u7684\u89c6\u9891\u4e2d\u90fd\u4f1a\u4ecb\u7ecd\u5806\u780c\u6807\u7b7e\u9875\u4ee5\u53ca\u5de5\u4f5c\u533a\uff0c\u5b83\u4eec\u90fd\u662f\u5386\u53f2\u60a0\u4e45\u7684\u5b98\u65b9\u529f\u80fd\u3002</p> <p>\u53ef\u80fd\u662f\u56e0\u4e3a\u8fd9\u4e9b\u529f\u80fd\u4f7f\u7528\u8005\u8f83\u5c11\uff0c\u5bfc\u81f4\u540e\u6765\u7684Obsidian\u6559\u7a0b\u4e2d\u5f88\u5c11\u4ecb\u7ecd\u5b83\u4eec\u3002</p> <p>\u4ee5\u81f3\u4e8e\u8ba9\u4f60\u4ea7\u751f\u7684\u201c\u529f\u80fd\u88ab\u85cf\u201d\u7684\u611f\u89c9\u3002</p> <p>\u6211\u6ca1\u8bf4\u7684\u662f</p> <p>\u5979\u7684\u6807\u9898\u201c\u85cf\u201d\u8bf4\u5f97\u597d\uff0c\u6210\u529f\u5438\u5f15\u6211\u70b9\u51fb\u5e76\u5b8c\u6574\u89c2\u770b\u4e86\u6574\u4e2a\u89c6\u9891\u3002</p> <p>\u5979\u662f\u5728\u771f\u4e0d\u77e5\u9053\u8be5\u529f\u80fd\u7684\u60c5\u51b5\u4e0b\u5199\u51fa\u7684\u6807\u9898\uff0c\u6211\u6ca1\u6709\u7559\u8a00\u5938\u8fd9\u6807\u9898\u597d\uff0c\u662f\u5e0c\u671b\u505a\u89c6\u9891\u7684\u4eba\u4fdd\u6301\u521d\u5fc3\uff0c\u5c11\u4e00\u4e9b\u4e3a\u4e86\u6d41\u91cf\u800c\u52a0\u5165\u201c\u6807\u9898\u515a\u201d\u3002</p> <p>\u6211\u6ca1\u6709\u8bf4\u6211\u4e0d\u4f1a\u52a0\u5165\u201c\u6807\u9898\u515a\u201d\uff0c\u6211\u514b\u5236\u81ea\u5df1\u7684\u8a00\u8bba\uff0c\u4e0d\u5ba3\u4f20\u201c\u56e0\u4e3a\u6807\u9898\u6211\u624d\u70b9\u51fb\u4e86\u89c6\u9891\u201d\uff0c\u81f3\u5c11\u907f\u514d\u522b\u4eba\u56e0\u4e3a\u770b\u4e86\u6211\u7684\u8a00\u8bba\u800c\u6210\u4e3a\u201c\u6807\u9898\u515a\u201d\u3002</p> <p>\u4ee5\u4e0a\u6240\u505a\uff0c\u5bf9\u6211\u7684\u597d\u5904\u662f\uff1a\u51cf\u5c11\u4e86\u4e00\u4e2a\u6f5c\u5728\u7684\u6807\u9898\u515a\u3002<sup>3</sup></p> <p>\u603b\u7ed3 Mkdocs-material \u81ea\u5e26\u7684\u5e38\u7528\u6807\u6ce8\u5757\uff1aabstract\uff08\u6458\u8981&amp;\u6982\u8ff0\uff09\uff0cnote\uff08\u7b14\u8bb0\uff09\uff0cinfo\uff08\u8865\u5145\u4fe1\u606f\uff09\uff0cquote\uff08\u5f15\u7528\uff09\uff0cquestion\uff08\u95ee\u9898\uff09\uff0ctips\uff08\u6280\u5de7&amp;\u5efa\u8bae\uff09\uff0cexample\uff08\u793a\u4f8b\uff09\uff0cwarning\uff08\u8b66\u544a\uff09\uff0cbug\uff08\u5df2\u77e5\u95ee\u9898\uff09</p> <p>19:45 \u77ed\u5267\u89e3\u8bf4\uff08\u7ad6\u4e86\u4e2a\u4e09\uff09\uff1a\u300a\u7a3b\u8349\u4eba\u300b</p> <p>20:03 \u6ca1\u5fc5\u8981\u770b\u4e86\uff0c\u5267\u60c5\u6df7\u4e71\u62d6\u62c9\uff0c\u4e0d\u5982\u300a\u6740\u4eba\u51f6\u624b\u300b\u3002</p> <p>20:17 \u803f\u540c\u5b66\uff1a\u3010\u5185\u5fc3\u5411\u3011\u6291\u90c1\u7684\u7814\u7a76\u751f\u751f\u6d3b\u3002\u539f\u6765\u535a\u58eb\u4e5f\u4f1a\u7126\u8651\u6bd5\u4e1a\u540e\u4e0e\u672c\u79d1\u3001\u7855\u58eb\u627e\u4e00\u6837\u7684\u5de5\u4f5c\u3002</p> <p>21:12 \u5411Github\u4ed3\u5e93\u505a\u4e86\u4e00\u6b21\u63a8\u9001\uff0c\u4e89\u53d6\u4ee5\u540e\u628a\u6574\u4e2a\u6d41\u7a0b\u7b80\u5316\u3002</p> <ol> <li> <p>\u8be5\u6587\u4ef6\u4e0d\u5728<code>docs</code>\u76ee\u5f55\u4e0b\uff0c\u4e0d\u4f1a\u88abmkdocs\u6e32\u67d3\u3002\u00a0\u21a9</p> </li> <li> <p>\u533a\u522b\uff1a\u524d\u8005\u6709cmd\u7a97\u53e3\uff0c\u53ef\u67e5\u770b\u62a5\u9519\u4fe1\u606f\uff1b\u540e\u8005\u65e0cmd\u7a97\u53e3\uff0c\u4f46\u4e0d\u53ef\u4ee5\u67e5\u770b\u62a5\u9519\u3002\u00a0\u21a9</p> </li> <li> <p>\u8fd9\u4e2a\u201c\u4e00\u201d\u662f\u6211\u6545\u610f\u8bf4\u7684\uff0c\u6211\u6ca1\u6709\u4f7f\u7528\u6a21\u7cca\u7684\u8868\u8fbe\u8bf4\u201c\u53ef\u80fd\u6210\u4e3a\u6807\u9898\u515a\u7684\u4eba\u201d\uff0c\u4e5f\u6ca1\u6709\u4f7f\u7528\u5938\u5f20\u7684\u8868\u8fbe\u8bf4\u201c\u89c2\u770b\u89c6\u9891\u8bc4\u8bba\u7684\u51e0\u767e\u4e2a\u4eba\u201d\u3002\u8fd9\u4e2a\u201c\u4e00\u201d\u662f\u660e\u786e\u7684\uff0c\u6211\u8981\u8ba9\u81ea\u5df1\u76f8\u4fe1\uff08\u7ed9\u81ea\u5df1\u5584\u610f\u5730\u6d17\u8111\uff09\uff0c\u8fd9\u4e48\u505a\u7684\u786e\u6709\u7528\u3002\u00a0\u21a9</p> </li> </ol>","tags":["tool-mkdocs"],"boost":1},{"location":"2026/06/2026-06-06/","title":"2026-06-06","text":"<p>02:04 \u8d81\u7740\u665a\u4e0a\u7528Trae\u7684\u4eba\u5c11\uff0c\u8ba9AI\u4f18\u5316\u4e86\u4e00\u8fb9Anki\u5185\u5bb9\u5361\u7247\u7684css\uff0c\u6548\u679c\u660e\u663e\u63d0\u5347\u4e86\u3002</p> <p>02:09 \u592a\u56f0\u4e86\uff0c\u51c6\u5907\u7761\u89c9\u5427\u3002</p> <p>09:14 \u770b\u5c0f\u5766\u514b\u5170\u535a\u76f4\u64ad\u3002</p> <p>09:30 \u73b0\u5728\u60f3\u60f3\u6709\u4ec0\u4e48\u4e0a\u4f20\u5230github\u7684\u56fe\u7247\uff0c\u4eca\u5929\u4e00\u5757\u4e0a\u4f20\u3002</p> <p>11:21 \u4f7f\u7528\u4e92\u4f20\u628a\u56fe\u7247\u62f7\u8d1d\u5230\u7535\u8111\uff0c\u6311\u9009\u56fe\u7247\u5e76\u4e0a\u4f20\u5230github\uff0c\u5728mkdocs\u535a\u5ba2\u94fe\u63a5\u5e76\u7b80\u8ff0\u56fe\u7247\uff0c\u5411DeepSeek\u8bf7\u6559Mkdocs\u4e2d\u7684\u56fe\u7247\u94fe\u63a5\u5c45\u4e2d\u3001\u7f29\u653e\u7b49\u8bed\u6cd5\uff0c\u5728Obsidian\u4e2d\u505a\u7b14\u8bb0\uff0c\u5bf9mkdocs\u535a\u5ba2\u4e2d\u7684\u56fe\u7247\u5e94\u7528<code>{ }</code>\u8bed\u6cd5\u4ee5\u65bd\u52a0\u5c45\u4e2d\u3001\u5907\u6ce8\u3001\u94fe\u63a5\u7b49\u4fe1\u606f\u3002\u5fd9\u5b8c\u4e00\u770b\uff0c\u7adf\u8fc7\u53bb\u5c06\u8fd1\u4e24\u4e2a\u5c0f\u65f6\u3002</p> <p>jscdn\u96be\u9053\u4e0d\u4f1a\u66f4\u65b0\u5df2\u6709\u8bb0\u5f55\u7684\u3001\u88ab\u4fee\u6539\u8fc7\u7684\u6587\u4ef6\uff1f\u4e3a\u4ec0\u4e48\u6211\u4fee\u6539\u8fc7\u5c3a\u5bf8\u7684\u4e24\u5f20\u56fe\u7247\u5df2\u7ecf\u4e0a\u4f20github\u89c6\u51e0\u5206\u949f\u4e86\uff0c\u8fd8\u6ca1\u6709\u53d8\u5316\u3002</p> <p>11:40 \u8ba9Genimi\u5e2e\u6211\u5199\u4e86\u4e00\u4e2a\u4f18\u5316Obsidian\u4ee3\u7801\u5757\u7684css\uff0c\u6548\u679c\u5982\u4e0b\uff1a</p> <p></p> <p>12:17 \u8ba9Gemini\u5e2e\u6211\u4e3amkdocs\u5199\u4e86css+js\u4ee3\u7801\uff0c\u5b9e\u73b0\u6548\u679c\u53ef\u4ee5\u901a\u8fc7\u4e0a\u56fe\u611f\u53d7\uff1a</p> <ol> <li>\u56fe\u7247\u56db\u5468\u589e\u52a0\u8fb9\u6846\u3001\u5706\u89d2\u7b49\u8bbe\u8ba1\uff0c\u7f8e\u5316\u5c55\u793a\u6548\u679c\u548c\u4e0e\u80cc\u666f\u5c42\u6b21\u5206\u660e\uff1b</li> <li>\u9f20\u6807\u653e\u7f6e\u5728\u56fe\u7247\u4e0a\u4f1a\u6709\u6296\u52a8\u6548\u679c\uff1b</li> <li>\u70b9\u51fb\u56fe\u7247\u5373\u53ef\u653e\u5927\u67e5\u770b\uff0c\u6309<code>Esc</code>\u3001<code>\u7a7a\u683c</code>\u53ef\u5173\u95ed\u8be5\u6548\u679c\u3002</li> <li>13:07 \u5b9e\u73b0\u53ef\u4ee5\u901a\u8fc7\u9f20\u6807\u6eda\u8f6e\u5bf9\u653e\u5927\u540e\u7684\u56fe\u7247\u8fdb\u884c\u8fdb\u4e00\u6b65\u653e\u5927\u3002</li> </ol> <p>12:26 \u987a\u4fbf\u8ba9Gemini\u5e2e\u6211\u66f4\u65b0\u4e86Obsidian\u7f29\u5c0f\u56fe\u7247\uff08\u9f20\u6807\u653e\u5728\u4e0a\u9762\u624d\u4f1a\u653e\u5927\uff09\u7684css\uff0c\u73b0\u5728\u5b83\u53ef\u4ee5\u5728\u9884\u89c8\u6a21\u5f0f\u3001\u7f16\u8f91\u6a21\u5f0f\u548c\u9605\u8bfb\u6a21\u5f0f\u90fd\u751f\u6548\u3002</p> <p>12:56-13:30 \u770b\u4e10\u4f26\u83cc\u76f4\u64ad\uff0c\u4eba\u624d\u5e02\u573a\u6253\u74e6\u505a\u8282\u76ee\u6548\u679c\u3002</p> <p>17:16 \u8ba9Gemini\u4f18\u5316\u4e86Obsidian\u5d4c\u5165\u7b14\u8bb0\u8fb9\u6846\uff0c\u73b0\u5728\u5b83\u53ea\u5bf9<code>.md</code>\u6587\u4ef6\u751f\u6548\u3002</p> <p>18:21 \u5b9e\u6d4b\u6d77\u4fe1WV50G-1\u6eda\u7b52\u6d17\u8863\u673a\u6d17\u5185\u88e4\uff0c1\u4e2a\u5c0f\u65f6\uff0c\u6d17\u4e0d\u5e72\u51c0\u3002\u4e0d\u5982\u6211\u624b\u6d1715\u5206\u949f\u3002</p> <ul> <li> \u8fd9\u6b21\u7684\u81ea\u52a8\u6295\u653e\u9009\u7528\u201cL-1\u201d\uff0c\u6d17\u8863\u6db2\u6ca1\u7528\u591a\u5c11\uff0c\u4e0b\u6b21\u9009\u201cL-3\u201d\u6d4b\u8bd5\u6d17\u6da4\u6548\u679c\u3002</li> </ul> <p>\u6211\u670d\u4e86DeepSeek\u548c\u8c46\u5305\uff0c\u80fd\u4e0d\u80fd\u67e5\u51fa\u6d77\u4fe1WV50G-1\u5177\u5907\u6295\u653e\u529f\u80fd\uff0c\u5168\u9760\u8fd0\u6c14\u3002</p> <p>23:43 \u51e1\u4eba\u4fee\u4ed9\u4f20\uff1a\u7b2c76\u8bdd \u661f\u6d77\u98de\u9a70\u5e8f\u7ae04\uff1a\u91d1\u594e\u538b\u529b\u6781\u9634\u3001\u98ce\u5e0c\u6218\u96f7\u9e4f\u3001\u97e9\u7acb\u7ed3\u4e39\u3002</p>","tags":["life-\u56fe\u7247\u6545\u4e8b","tool-mkdocs"],"boost":1},{"location":"2026/06/2026-06-06/#_1","title":"\u56fe\u7247\u6545\u4e8b","text":"<p>Microsoft To Do \u6700\u65b0\u6e05\u5355\u547d\u540d\uff08GTD\u5de5\u4f5c\u6d41\uff09\uff1a</p> <p></p> <p>\u7ed9\u5c0f\u5916\u7525\u505a\u57ab\u5b50</p> <p></p> <p>\u6ca1\u6709\u6253\u5149\u7684\u76f4\u64ad\u95f4be like\uff1a</p> <p></p> <p>\u6709\u6253\u5149\u7684\u76f4\u64ad\u95f4be like\uff08\u5f71\u89c6\u98d3\u98ce\uff09\uff1a</p> <p>\u6211\u672c\u4eba\u7b2c\u4e00\u6b21\u5728\u6296\u97f3\u5237\u5230\u5f71\u89c6\u98d3\u98ce\uff1a</p> <p></p> <p>\u7ef4\u7ef4\u8c46\u5976\u5728\u8d85\u5e02\u7684\u4ef7\u683c\uff08\u6bd4\u6296\u97f3\u76f4\u64ad\u95f4\u4fbf\u5b9c\u4e00\u534a<sup>1</sup>\uff09\uff1a</p> <p></p> <p>\u8ddf\u6bd5\u5bfc\u5b66\u5e38\u8bc6\uff08\u5e38\u89c1\u7269\u54c1\u3001\u6750\u8d28\u7684\u6469\u64e6\u8d77\u7535/\u9759\u7535\u6392\u884c\u699c\uff09\uff1a</p> <p></p> <p>\u6296\u97f3\u5237\u5230\u7684\uff0c\u4e09\u53ea\u9e1f+\u4e00\u53ea\u732b\u6b63\u5728\u56f4\u730e\u4e00\u53ea\u8001\u9f20\uff0c\u52a8\u753b\u7247\u624d\u6709\u7684\u753b\u9762\uff1a</p> <p></p> <p>\u6211\u4e0d\u660e\u767d\uff0c\u4e3a\u4ec0\u4e48\u66fe\u7ecf\u89c9\u5f97\u7f8e\u82e5\u5929\u4ed9\u7684\u5f02\u6027\uff08\u963f\u59ae\u5a05\uff09\uff0c\u5982\u4eca\u518d\u770b\uff0c\u6ca1\u6709\u4e86\u5f80\u65e5\u7684\u5174\u8da3\uff0c\u96be\u9053\u8fd9\u5c31\u662f\u7537\u6027\uff1f</p> <p></p> <p></p> <p></p> <p></p> <p></p> <p></p> <ol> <li> <p>\u7528\u5728\u6296\u97f3\u4e70200g\u5976\u7c89\u7684\u94b1\uff0c\u5728\u8d85\u5e02\u80fd\u4e70\u5230300g\u3002\u76f4\u64ad\u95f4\u53e3\u53e3\u58f0\u58f0\u5ba3\u4f20\u201c\u6700\u4f4e\u4ef7\u201d\u3001\u201c618\u5927\u4fc3\u201d\u3002\u592a\u5272\u88c2\u4e86\u3002\u00a0\u21a9</p> </li> </ol>","tags":["life-\u56fe\u7247\u6545\u4e8b","tool-mkdocs"],"boost":1},{"location":"2026/06/2026-06-07/","title":"2026-06-07","text":"","tags":["tool-mkdocs"],"boost":1},{"location":"2026/06/2026-06-07/#_1","title":"\u8bbe\u5b9a\u76ee\u6807","text":"<p>\u6211\u8ba4\u4e3a\u5f53\u52a1\u4e4b\u6025\u662f\u9009\u5b9a\u4e00\u4e2a\u76ee\u6807\uff0c\u7136\u540e\u5168\u8eab\u5fc3\u6295\u5165\u3002\u629b\u5f00\u4e00\u5207\u65e0\u5173\u7d27\u8981\u7684\u4e8b\u60c5\u3001\u6b32\u671b\uff0c\u5168\u529b\u53bb\u505a\u3002</p> <p>08:24~09:31 \u8ba9Gemini\u5e2e\u6211\u91cd\u65b0\u4f18\u5316\u8bbe\u8ba1\u4e86Anki\u5361\u7247\u7684\u6837\u5f0f\u3002\u7ed3\u6784\u6df1\u5f97\u6211\u5fc3\uff0c\u53ea\u662f\u8fd8\u9700\u8981\u6536\u96c6\u4e2d\u610f\u7684\u914d\u8272\u4f53\u7cfb\u3002</p> <p>09:57 \u8f6f\u4ef6\u5206\u4eab</p> <ul> <li>CopyTranslator \u5f00\u6e90\u590d\u5236\u5373\u7ffb\u8bd1\u7684\u5916\u6587\u8f85\u52a9\u9605\u8bfb\u7ffb\u8bd1\u89e3\u51b3\u65b9\u6848\u3002</li> <li>Umi-OCR  \u5f00\u6e90\u3001\u514d\u8d39\u7684\u79bb\u7ebfOCR\u8f6f\u4ef6\u3002\u652f\u6301\u622a\u5c4f/\u6279\u91cf\u5bfc\u5165\u56fe\u7247\uff0cPDF\u6587\u6863\u8bc6\u522b\uff0c\u6392\u9664\u6c34\u5370/\u9875\u7709\u9875\u811a\uff0c\u626b\u63cf/\u751f\u6210\u4e8c\u7ef4\u7801\u3002</li> </ul> <p>10:10 GPT-Image-2 \u63d0\u793a\u8bcd Github\u5f00\u6e90\u63d0\u793a\u8bcd\u5e93</p> <p>\u8ba9Gemini\u6559\u6211\u5236\u4f5c\u4e86\u5feb\u901f\u6dfb\u52a0MkDocs\u6807\u6ce8\u5757\u7684\u811a\u672c\uff08\u811a\u672c\u7684\u6837\u5f0f\u662f\u6628\u5929\u8ba9Gemini\u5347\u7ea7\u7684\uff09\u3002</p> <p></p> <p>12:32 \u5f00\u59cb\u5236\u4f5c\u4e94\u5f69\u70df\u82b1\u9f20\u6807\u7279\u6548</p> <p>18:34 \u4ece\u9f20\u6807\u7279\u6548\u8054\u60f3\u5230\u80cc\u666f\u7279\u6548\u3002\u6210\u679c</p> <ul> <li>\u9f20\u6807\u7279\u6548\uff1a\u4e94\u5f69\u5212\u7ebf\u3001\u9b54\u6cd5\u661f\u661f\u3001\u70b8\u70df\u82b1\u7b49\u3002</li> <li>\u80cc\u666f\u7279\u6548\uff1a\u661f\u661f\u96e8\u3001\u94f6\u674f\u6811\u53f6\u3001\u6a31\u82b1\u3001\u96e8\u5929\u3001\u6253\u96f7\u7b49\u3002</li> </ul> <p>\u987a\u4fbf\u6309\u81ea\u5df1\u7684\u559c\u597d\u8bbe\u7f6e\u4e86\u4ee5\u4e0b\u5185\u5bb9\uff1a</p> <ul> <li>\u6d45\u8272\u6a21\u5f0f<sup>1</sup>\u548c\u6df1\u8272\u6a21\u5f0f<sup>2</sup>\u7684\u4e3b\u9898\u914d\u8272\u3002\u8fd8\u5355\u72ec\u4e3a\u6df1\u8272\u6a21\u5f0f\u8bbe\u7f6e\u4e86\u4ee3\u7801\u5757\u80cc\u666f\u8272<sup>3</sup>\u548c\u66f4\u4eae\u7684\u52a0\u7c97\u5b57\u4f53\u989c\u8272<sup>4</sup>\u3002</li> <li>\u56fe\u7247\u5706\u89d2\u662f\u6628\u5929\u8bbe\u8ba1\u7684\uff0c\u4eca\u5929\u5c06\u5706\u89d2\u534a\u5f84<code>border-radius</code>\u6539\u4ece<code>5px</code>\u6539\u6210<code>17px</code>.</li> <li>\u5916\u90e8\u94fe\u63a5\u5c5e\u6027\u5217\u8868\u4e13\u7528\u7684css\uff1a<code>.external-link</code>.</li> <li>\u628a\u4e00\u90e8\u5206css\u4ece<code>extra.css</code>\u4e2d\u5206\u79bb\u81f3\u65b0\u6587\u4ef6\u4e2d\uff0cjs\u4ee3\u7801\u540c\u6837\u3002</li> </ul> <p>\u4e94\u5f69\u5212\u7ebf\u9f20\u6807\u7279\u6548\u6bd4\u8f83\u82b1\u54e8\uff0c\u8fd8\u9700\u8981\u7cbe\u7b80\u3002\u4e0b\u697c\u641e\u70b9\u5403\u7684\uff0c\u4e00\u5929\u6ca1\u5403\u996d\u4e86\uff0c\u665a\u4e0a\u7fa4\u91cc\u76f4\u64ad\u4e86\u3002</p> <p>20:31 \u524d\u9762\u90a3\u5f20\u56fe\u7247\u81ea\u5e26\u8fb9\u6846\uff0c\u4e0d\u9002\u5408\u518d\u5957\u7528\u6211\u7684\u81ea\u5b9a\u4e49\u56fe\u7247\u5706\u89d2+\u8fb9\u6846+\u60ac\u505c\u53cd\u9988\u6837\u5f0f\uff0c\u4e8e\u662f\u6211\u8ba9Gemini\u5c06\u5176\u8f6c\u6362\u4e3a\u4e00\u4e2a<code>.card-img</code>\u7c7b\uff0c\u73b0\u5728\u5c06\u5176\u4f5c\u4e3a\u5c5e\u6027\u5217\u8868\uff0c\u4ece\u6d88\u6781\u5e94\u7528\u6539\u4e3a\u79ef\u6781\u9009\u7528\u3002</p> <p>21:00~21:30 \u8ba9Gemini\u5e2e\u6211\u628a\u51e0\u4e4e\u6240\u6709\u5e26\u7a97\u4f53\u7684\u811a\u672c\u6539\u9020\u4e3a\u4e0a\u56fe\u7684\u6837\u5f0f\u3002</p> <p>21:31 \u611f\u89c9\u54c8\u96f7\u2604\ufe0f\u4e5f\u662f\u521a\u521a\u5f00\u59cb\u5b66\u4e60\u4f7f\u7528AI\uff0c\u8bb2\u7684\u5185\u5bb9\u90fd\u6bd4\u8f83\u57fa\u7840\u3002</p> <p>\u76f4\u89c9\u544a\u8bc9\u73b0\u5728\u7684\u7f51\u7ad9\u80cc\u666f\u7279\u6548\u55a7\u5bbe\u593a\u4e3b\uff0c\u4f7f\u6211\u5fc3\u70e6\u610f\u4e71\uff0c\u4e8e\u662f\u6211\u51cf\u5c11\u4e86\u7f51\u7ad9\u80cc\u666f\u7279\u6548\u4e2d\u8424\u706b\u866b\u3001\u661f\u661f\u3001\u67ab\u53f6\u3001\u96ea\u82b1\u7684\u6570\u91cf\u3002\u8fd9\u624d\u53d1\u73b0\u521a\u521a\u5c4f\u5e55\u4e0a\u7adf\u7136\u670980\u4e2a\u661f\u661f+20\u4e2a\u8424\u706b\u866b\u3002</p> <p>22:51 \u4e09\u4e07\u7c89\u4e1d\u7684\u8d26\u53f7\u5f00\u76f4\u64ad\uff0c\u5c31\u53ef\u4ee5\u8fbe\u5230\u89c2\u4f17300+\u4e86\u561b\uff0c\u542c\u8bf4\u56e0\u4e3a\u4eca\u5929\u9ad8\u8003\u5c11\u4e86\u8fd8\u5c11\u4e86100\u4eba\uff08\u8304\u5b50\u5c0f\u5e03\u4e01\uff09\u3002</p> <p>\u6211\u4ee5\u4e3aB\u7ad9\u8981\u5341\u4e07\u7c89\u4e1d\u7684\u8d26\u53f7\u624d\u80fd\u8fbe\u5230100+\u76f4\u64ad\u95f4\u89c2\u4f17\u3002</p> <p>\u770b\u4e86\u8fd9\u4e2a\u73a9\u4fc4\u6d1b\u4f0a\u7684\u4e3b\u64ad\u7206\u7092\u80a5\u80a0\u54bf\u5440\uff0c1.6\u4e07\u7c89\u4e1d\uff0c\u76f4\u64ad\u95f4\u53ea\u67099\u4eba\u3002\u8fd9\u79cd\u624d\u662f\u6211\u8ba4\u77e5\u4e2d\u7684bilibili\u3002</p> <p>23:18 \u3010MrBeast\u5b98\u65b9\u3011\u6311\u6218\u5317\u6781\u6781\u9650\u751f\u5b587\u5929\uff0c\u6211\u505a\u5230\u4e86\uff01</p> <p>\u7531\u4e8e\u6211\u65e9\u5c31\u538c\u5026\u4e86\u5728edge\u5730\u5740\u680f\u590d\u5236\u7684\u94fe\u63a5\u4e2d\u4f1a\u6709\u8bb8\u591a\u8ddf\u8e2a\u53c2\u6570\uff0c\u5728\u6211\u590d\u5236\u4e86\u4e0a\u9762\u8fd9\u4e2a\u94fe\u63a5\u5e76\u8f93\u5165\u5230Obsidian\u4e2d\u540e\uff0c\u4eca\u5929\u4e00\u4e0b\u5348\u90fd\u5f00\u7740VPN\uff0c\u9760Gemini\u5e2e\u6211\u89e3\u51b3\u4ee3\u7801\u95ee\u9898\uff0c\u5bf9AI\u7684\u4f9d\u8d56\u5df2\u88ab\u70b9\u71c3\uff0c\u6240\u4ee5\u6211\u76f4\u63a5\u5f00\u59cb\u5411AI\u5bfb\u6c42\u590d\u5236\u7eaf\u51c0\u94fe\u63a5\u7684\u89e3\u51b3\u65b9\u6848\u3002</p> <p>\u6211\u6700\u521d\u7684\u8bbe\u60f3\u662f\u8ba9AI\u5e2e\u6211\u505a\u4e00\u4e2a\u4ee3\u7801\uff0c\u5b9e\u65f6\u76d1\u89c6\u6211\u7684\u526a\u5207\u677f\uff0c\u5bf9\u8bc6\u522b\u5230\u7684\u94fe\u63a5\u8fdb\u884c\u683c\u5f0f\u5316\u64cd\u4f5c\uff0c\u53bb\u9664\u8ddf\u8e2a\u53c2\u6570\u3001\u8f6c\u5316\u4e3amarkdown\u8bed\u6cd5\uff1a<code>[\u7f51\u9875\u6807\u9898](\u6781\u7b80\u7f51\u7edc\u5730\u5740)</code>\u3002</p> <p>\u4f46\u662fGemini\u544a\u8bc9\u6211\u53ef\u4ee5\u4e0b\u8f7d\u6d4f\u89c8\u5668\u63d2\u4ef6\u3002\u4e8e\u662f\u6211\u76f4\u63a5\u53bb\u95eeDeepSeek\uff0c\u6709\u54ea\u4e9b\u6d4f\u89c8\u5668\u63d2\u4ef6\u53ef\u4ee5\u5e2e\u6211\u89e3\u51b3\u8be5\u95ee\u9898\uff0c\u6211\u5f97\u77e5\u4e86\u4ee5\u4e0b\u5de5\u5177\uff1a</p> <ol> <li>Arclet Copier - \u667a\u80fdURL\u590d\u5236\u4e0e\u5206\u4eab</li> <li>ClearURLs - Microsoft Edge Addons<ul> <li>\u5f88\u4e45\u5f88\u4e45\u4e4b\u524d\u7684\u5927\u5b66\u65f6\u671f\uff0c\u8fd9\u4e2a\u63d2\u4ef6\u5c31\u88ab\u6211\u4e0b\u8f7d\u4e86\uff0c\u4eca\u5929\u624d\u77e5\u9053\u4f7f\u7528</li> <li>\u5b98\u65b9\u89c4\u5219\uff1adata.minify.json</li> </ul> </li> </ol> <p>\u975e\u76ee\u6807\u5de5\u5177</p> <ul> <li>Url Shortener<ol> <li>\u529f\u80fd\u5f3a\u5927\uff0c\u4f46\u9700\u8981\u6ce8\u518c\u3001\u4ed8\u8d39</li> <li>\u53ef\u4ee5\u6279\u91cf\u7f29\u77edURL</li> </ol> </li> <li>Copy Title and Url as Markdown Style<ul> <li>\u53ea\u80fd\u5f53\u4f5c\u4e00\u952e\u590d\u5236\u5de5\u5177\uff0c\u8be5\u63d2\u4ef6\u4e0d\u80fd\u53bb\u9664\u65e0\u6548\u53c2\u6570</li> </ul> </li> <li>Copy as Markdown<ol> <li>\u4e00\u952e\u5c06\u5f53\u524d\u6253\u5f00\u7684\u6240\u6709\u7f51\u9875\u94fe\u63a5\u590d\u5236\u4e3aMarkdown\u94fe\u63a5\uff08ToDo or List\uff09\u3001\u4ec5\u6807\u9898\u3001\u4ec5\u94fe\u63a5</li> <li>\u590d\u5236\u5f53\u524d\u7f51\u9875\u94fe\u63a5</li> <li>\u53ea\u80fd\u5f53\u4f5c\u4e00\u952e\u8f85\u52a9\u5de5\u5177\uff0c\u8be5\u5de5\u5177\u4e0d\u80fd\u53bb\u9664\u65e0\u6548\u53c2\u6570</li> </ol> </li> <li>linkmark<ul> <li>\u7f51\u7ad9\u6536\u85cf\u5bb9\u5668\uff0c\u8fd9\u4e2a\u63d2\u4ef6\u6211\u81ea\u5df1\u5f00\u53d1\u4e86\uff0c\u6bd4\u5b83\u7684\u529f\u80fd\u597d</li> </ul> </li> </ul> <p>\u77ed\u94fe\u670d\u52a1is.gd\u548ctinyurl\u6709\u4ec0\u4e48\u533a\u522b\uff1f</p> <p>is.gd\uff1a\u8ffd\u6c42\u6781\u81f4\u7684\u77ed\u3002\u5b83\u7684\u57df\u540d\u53ea\u6709 5 \u4e2a\u5b57\u7b26\u3002\u5b8c\u5168\u514d\u8d39\u4e14\u8be6\u7ec6\u3002\u514d\u8d39\u652f\u6301\u81ea\u5b9a\u4e49\u522b\u540d\u3002\u7eaf\u7cb9\u7684\u5b66\u9662\u6d3e/\u6781\u5ba2\u98ce\uff0c\u65e0\u9700\u6ce8\u518c\u3002\u63d0\u4f9b\u6781\u5176\u7b80\u5355\u4e14\u65e0\u95e8\u69db\u7684 API\u3002\u5199Python\u4ee3\u7801\u7684\u9996\u9009\u3002 TinyURL\uff1a\u5b58\u5728\u4ed8\u8d39\u529f\u80fd\u3002\u514d\u8d39\u652f\u6301\u81ea\u5b9a\u4e49\u522b\u540d\u3002\u73b0\u4ee3\u5546\u4e1a\u5316\u5de5\u5177\u3002\u9700\u8981\u4f60\u6ce8\u518c\u8d26\u53f7\u5e76\u643a\u5e26 API Key \u624d\u80fd\u8c03\u7528\uff0c\u4e14\u514d\u8d39\u8d26\u6237\u6709\u989d\u5ea6\u9650\u5236\u3002\u4f01\u4e1a\u7528\u6237\u89c4\u8303\u540e\u53f0\u7ba1\u7406\u9996\u9009\u3002</p> <ol> <li> <p> \u21a9</p> </li> <li> <p> \u21a9</p> </li> <li> <p> \u21a9</p> </li> <li> <p> \u21a9</p> </li> </ol>","tags":["tool-mkdocs"],"boost":1},{"location":"2026/06/2026-06-08/","title":"2026-06-08","text":"","tags":["tool-mkdocs"],"boost":1},{"location":"2026/06/2026-06-08/#_1","title":"\u4e0a\u5348","text":"<p>05:01~06:39 \u5411Gemini\u8bf7\u6559\u4e86jsDelivr\u7684\u7528\u6cd5\u3002</p> <p>\u6709AI\u4e4b\u540e\uff0c\u5b66\u4e60\u6548\u7387\u5927\u5927\u63d0\u9ad8\u3002\u6211\u8ba4\u4e3a\u6700\u5173\u952e\u7684\u5730\u65b9\u5728\u4e8e\uff0c\u201cxx\u662f\u5e72\u4ec0\u4e48\u7684\u201d\u3001\u201cxx\u7684\u539f\u7406\u662f\u4ec0\u4e48\u201d\u8fd9\u7c7b\u6838\u5fc3\u95ee\u9898\u90fd\u6709\u4e86\u53cd\u9988\u3002</p> <p>\u4ee5\u524d\u6211\u9760\u5199\u535a\u5ba2\u7684\u4eba\u51fa\u6559\u7a0b\u5b66\u4e60\u4f7f\u7528jsDelivr\uff0c\u4f5c\u8005\u81ea\u5df1\u662f\u771f\u7684\u61c2\uff0c\u4f46\u4e0d\u5173\u5fc3\u8bfb\u8005\u641e\u6ca1\u641e\u61c2\u3002\u4ed6\u4eec\u5199\u7684\u5f80\u5f80\u662f\u6982\u8ff0\u6027\u7684\u3001\u9762\u5411\u81ea\u5df1\u7684\u7b14\u8bb0\u3002\u770b\u5b8c\u6559\u7a0b\uff0c\u6211\u77e5\u5176\u7136\u4e0d\u77e5\u5176\u6240\u4ee5\u7136\uff0c\u4ece\u672a\u7406\u89e3\u670d\u52a1\u8fd0\u884c\u7684\u539f\u7406\uff0c\u867d\u7136\u7a0b\u5e8f\u4e5f\u80fd\u8dd1\u8d77\u6765\uff0c\u4f46\u518d\u5f00\u65b0\u4ed3\u5e93\u3001\u4e0a\u4f20\u65b0\u6587\u4ef6\uff0c\u90fd\u8981\u91cd\u65b0\u641c\u7d22\u3001\u786e\u8ba4url\u7684\u5199\u6cd5\u3002</p> <p>Gemini \u6253\u901a\u4e86\u6211\u7684\u4efb\u7763\u4e8c\u8109\uff01\u8ba9\u6211\u5f7b\u5e95\u641e\u6e05\u695ajsDelivr\u7684\u539f\u7406\uff0c\u73b0\u5728\uff0c\u6211\u53ef\u4ee5\u6ee1\u6000\u6b23\u559c\u5730\u62cd\u80f8\u812f\u4fdd\u8bc1\uff0c\u6211\u4e0d\u9700\u8981\u518d\u641cjsDelivr\u6559\u7a0b\u4e86\uff08\u4f46\u8fd8\u4f1a\u5411AI\u8bf7\u6559\uff09\u3002</p> <p>\u6700\u8fd1\u9ad8\u9891\u4f7f\u7528Gemini\uff0c\u56e0\u4e3a\u6211\u53d1\u73b0DeepSeek\u548cChatGPT\u90fd\u964d\u667a\u4e86\u3002\u8c46\u5305\u66f4\u522b\u63d0\u3002\u73b0\u5728\u6211\u8bc4\u4f30AI\u5b9e\u529b\u7684\u65b9\u6cd5\u5c31\u662f\u628a\u540c\u4e00\u4e2a\u5b9e\u9645\u7684\u524d\u7aef\u9700\u6c42\u4ea4\u7ed9\u4e0d\u540c\u7684AI\uff0c\u6839\u636e\u7ed3\u679c\u6253\u5206\u3002\u6bd4\u5982\u524d\u5929\uff0c\u6211\u8ba9AI\u5e2e\u6211\u4f18\u5316Anki\u5361\u7247\u6a21\u677f\u6837\u5f0f\uff0cChatGPT\u7684\u6240\u6709\u8fd4\u56de\u7ed3\u679c\u90fd\u5b58\u5728bug\uff0c\u8ddf\u8c46\u5305\u505a\u4e00\u684c\u3002</p> <p>\u73b0\u5728\u6211\u6240\u6709Anki\u6a21\u677f\u3001\u811a\u672c\u7a97\u4f53\u7684\u6700\u65b0\u6837\u5f0f\uff0c\u90fd\u662fGemini\u5b9e\u73b0\u7684\u3002</p> <p>07:01 \u8fdc\u91ce\u8d1d\u857e\u4e9a\uff0c\u5728\u76f4\u64ad\u95f4\u653e\u5f55\u50cf+\u88c5\u5907\u680f\u5e55\u5203\u88c5\u5907\u8d34\u56fe\uff0c\u9a97\u5f97\u6211\u67e5\u4e86\u5b98\u7f51\u88c5\u5907\u5e93\u548c\u8fd1\u4e24\u4e2a\u6708\u7684\u7248\u672c\u66f4\u65b0<sup>1</sup>\uff0c\u5df2\u4e3e\u62a5\u3002</p> <p>\u6211\u5728b\u7ad9\u8fdb\u884c\u768490%\u4ee5\u4e0a\u7684\u4e3e\u62a5\u53cd\u9988\u90fd\u662f\uff0c\u8fd9\u6b21\u4e5f\u4e0d\u4f8b\u5916\uff1a\u60a8\u597d\uff0c\u6211\u4eec\u5df2\u6536\u5230\u60a8\u5bf9\u7a3f\u4ef6\u7684\u4e3e\u62a5\uff0c\u5c06\u4f1a\u91cd\u70b9\u5173\u6ce8\u8be5\u8d26\u53f7\u3002\u611f\u8c22\u60a8\u5bf9\u793e\u533a\u79e9\u5e8f\u7684\u7ef4\u62a4\u3002</p> <p>b\u7ad9\u7b97\u5f97\u4e0a\u662f\u56fd\u5185\u73af\u5883\u4e0b\u8f83\u5947\u8469\u7684\u5e73\u53f0\u3002\u6296\u97f3\u548c\u5c0f\u7ea2\u4e66\u628a\u7528\u6237\u5f53\u5c0f\u5b66\u751f\u6765\u7ba1\uff0c\u6562\u8bb2\u4e0d\u88ab\u5141\u8bb8\u7684\u5185\u5bb9\u5c31\u53d7\u7f5a\u3002b\u7ad9\u7684\u7b56\u7565\u4f3c\u4e4e\u662f\u65e0\u4e3a\u800c\u6cbb\uff0c\u80fd\u4e0d\u7ba1\u5c31\u4e0d\u7ba1\uff0c\u80fd\u5c11\u7ba1\u5c31\u5c11\u7ba1\u3002</p> <p>\u524d\u4e0d\u4e45\u7684\u201c\u62b1\u62b1\u76f2\u5154\u6446\u62cd\u4e8b\u4ef6\u201d\uff0c\u524d\u4e24\u4e2a\u5e73\u53f0\u65e9\u65e9\u4e0b\u67b6\u4e86\u76f8\u5173\u4f5c\u54c1\uff0cb\u7ad9\u5219\u662f\u4e00\u76f4\u5230\u56fd\u5bb6\u5b98\u65b9\u901a\u62a5\u4e8b\u4ef6\u7ed3\u679c\u540e\uff0c\u76f8\u5e94\u53f7\u53ec\uff0c\u4e0e\u5176\u4ed6\u5e73\u53f0\u4e00\u81f4\u5bf9\u201c\u62b1\u62b1\u76f2\u5154\u201d\u5b9e\u65bd\u5c01\u53f7\u5904\u7406\u3002</p> <p>\u6700\u5927\u7a0b\u5ea6\u5141\u8bb8\u591a\u79cd\u58f0\u97f3\u5b58\u5728\u7684\u5e73\u53f0\uff0c\u7a76\u7adf\u79ef\u6781\u7684\u5f71\u54cd\u591a\u4e00\u4e9b\uff0c\u8fd8\u662f\u6d88\u6781\u7684\u5f71\u54cd\u591a\u4e00\u4e9b\u5462\uff1f\u53c8\u6216\u8005\u8fd9\u662f\u4e0e\u76d1\u7ba1\u4e25\u683c\u7684\u5e73\u53f0\u7684\u4e00\u79cd\u4e92\u8865\u3002</p> <p>\u5982\u679c\u6bcf\u4e2a\u5e73\u53f0\u90fd\u65bd\u884c\u5c0f\u7ea2\u4e66\u7ea7\u522b\u7684\u6587\u5b57\u72f1\uff0c\u90a3\u4e48\u4f7f\u7528Twitter\u548cYoutobe\u7684\u4e2d\u56fd\u4eba\u5e94\u8be5\u4f1a\u53d8\u591a\u3002b\u7ad9\u662f\u4e00\u4e2a\u4fdd\u9669\u6813\uff0c\u628a\u5927\u90e8\u5206\u6fc0\u8fdb\u4e3b\u4e49\u8005\u7559\u5728\u4e86\u56fd\u5185\u3002</p> <p>09:05 \u770bPikaXxd\u76f4\u64ad\u5230\u73b0\u5728\uff0c\u4e0d\u770b\u4e86\u3002</p> <p>09:32 \u521a\u8bf4\u8d70\uff0c\u51c6\u5907\u5173\u7f51\u9875\uff0c\u6ca1\u60f3\u5230\u90a3\u5c40\u6709\u4e2a\u59b9\u59b9\uff0c\u7136\u540ePika\u5f00\u59cb\u88c5b\u3002\u6211\u770b\u5b8c\u4e86\u540e\u9762\u7684\u5927\u534a\u5c40\u3002\u5b9e\u529b\u5f3a\uff0c\u6e9c\u7740\u73a9\uff0cMVP\u62ff\u4e0b\uff0c\u770b\u5f97\u786e\u5b9e\u723d\u3002</p> <p>10:32 \u628a\u7f51\u7ad9\u590f\u5929\u7684\u590f\u6d1b\u7279\u5c0f\u4ece\u7eff\u8272\u94f6\u674f\u6811\u53f6\u6539\u6210\u4e867\u79cd\u51b0\u6fc0\u51cc\u3002</p> <p>\u94f6\u674f\u6811\u53f6\u80cc\u666f\u7279\u6548\u5df2\u95f2\u7f6e\uff0c\u5b83\u5e94\u5f53\u5728\u4ec0\u4e48\u60c5\u51b5\u4e0b\u4f7f\u7528\u5462\uff1f</p> <p>\u9664\u4e86\u5e76\u7ecf\u5386\uff0c\u6211\u8fd8\u4e0b\u8f7d\u4e86\u8bb8\u591a\u852c\u83dc\u3001\u96f6\u98df\u7c7b\u7684<code>.svg</code>\u6587\u4ef6\uff0c\u540e\u7eed\u518d\u641e\u7f51\u7ad9\u521b\u610f\u3002\u6211\u7684\u76ee\u6807\u662f\u4e3a\u81f3\u5c11\u627e\u5230365\u79cd\u4e0d\u540c\u4e14\u6709\u610f\u4e49\u7684\u80cc\u666f\u7279\u6548\uff0c\u8ba9\u7f51\u7ad9\u5728\u6bcf\u4e00\u5929\u90fd\u6709\u5438\u5f15\u529b\u3002\u6211\u5c0f\u65f6\u5019\u4f7f\u7528\u8fc7\u4e00\u6b3e\u58c1\u7eb8\u8f6f\u4ef6\uff0c\u6709\u4e00\u5957\u58c1\u7eb8\uff0c\u5f88\u53ef\u60dc\u6211\u53ea\u770b\u8fc7\u7b80\u4ecb\uff0c\u573a\u666f\u597d\u50cf\u662f\u4e00\u68f5\u6811\uff0c\u4e00\u5171365\u5f20\u58c1\u7eb8\u5c55\u73b0\u5b83\u4e00\u5e74\u56db\u5b63\u7684\u53d8\u5316\uff0c\u6bcf\u4e00\u5f20\u90fd\u4e0d\u540c\u3002</p> <p>\u4e5f\u8bb8\u662f\u56e0\u4e3a\u63cf\u7ed8\u540c\u4e00\u4e2a\u4e8b\u7269\u7684365\u79cd\u7ec6\u5fae\u5dee\u5f02\u592a\u590d\u6742\uff0c\u4e5f\u8bb8\u662f\u5229\u6da6\u4f4e\uff0c\u73b0\u5728\u6ca1\u6709\u4eba\u505a\u8fd9\u4ef6\u4e8b\u4e86\u3002\u6211\u60f3\u505a\u7684\u662f\u6311\u9009365\u79cd\u8868\u8fbe\u65b9\u5f0f\uff0c\u5236\u9020\u51fa\u6bcf\u4e00\u5929\u90fd\u72ec\u4e00\u65e0\u4e8c\u7684\u611f\u53d7\uff0c\u4e0d\u5fc5\u5728\u4e00\u4e2a\u4e8b\u7269\u4e0a\u96d5\u7422\uff0c\u5e94\u8be5\u6ca1\u90a3\u4e48\u96be\u505a\u3002</p> <ul> <li> \u7279\u6b8a\u5929\u6c14\u7684\u80cc\u666f\u7279\u6548\uff0c\u4f8b\u5982\u96e8\u3001\u96ea\u3001\u95ea\u7535\u3002</li> <li> \u7279\u6b8a\u8282\u65e5\u7684\u80cc\u666f\u7279\u6548\uff0c\u4f8b\u5982\u997a\u5b50\u3001\u7cbd\u5b50\u3001\u5723\u8bde\u793c\u7269\u3001\u7ea2\u5305\u3002</li> <li> \u7279\u6b8a\u65e5\u5b50\u7684\u80cc\u666f\u7279\u6548\uff0c\u4f8b\u5982\u751f\u65e5\u793c\u7269\u3001\u60c5\u4e66\u3001\u7ed3\u5a5a\u8bc1\u3002</li> <li> \u7279\u6b8a\u65f6\u95f4\u7684\u80cc\u666f\u7279\u6548\uff0c\u4f8b\u5982\u98df\u7269\u3001\u8db3\u7403\u3001\u7fbd\u6bdb\u7403\u3001\u91ce\u83ca\u3001\u4e66\u3002</li> </ul>","tags":["tool-mkdocs"],"boost":1},{"location":"2026/06/2026-06-08/#_2","title":"\u4e0b\u5348","text":"<p>13:13 \u6211\u641c\u7d22\u201c\u6f02\u4eae\u7684\u535a\u5ba2\u201d\uff0c\u51c6\u5907\u597d\u5c0f\u672c\u672c\u8bb0\u5f55\u597d\u7684\u521b\u610f\uff0c\u4ee5\u540e\u8ba9AI\u7ed9\u6211\u7f8e\u5316\u73b0\u5728\u7684\u7f51\u7ad9\u3002\u7136\u540e\u6765\u5230\u4e86POETIZE - \u6700\u7f8e\u535a\u5ba2\u3002\u4ed6\u4e5f\u6709\u4e0b\u843d\u82b1\u74e3\u7684\u80cc\u666f\u7279\u6548\u3002\u8fd9\u4e2a\u7f51\u7ad9\u672c\u8eab\u5c31\u662f\u5546\u54c1\uff0c\u5b83\u7684\u4e00\u5207\u884c\u4e3a\u90fd\u662f\u4e3a\u4e86279\u5143\u5c06\u6574\u5957\u7cfb\u7edf\u7684\u90e8\u7f72+\u552e\u540e\u4f5c\u4e3a\u4ea7\u54c1\u5356\u7ed9\u89c9\u5f97\u7f51\u7ad9\u7f8e\u7684\u89c2\u4f17\uff0c\u8bbf\u95ee\u91cf\u5f88\u5927\u3002</p> <p>\u4e0b\u9762\u6211\u8bb0\u5f55\u4e00\u4e9b\u81ea\u5df1\u7684\u770b\u6cd5\u3002\u4e00\u8a00\u4ee5\u853d\u4e4b\uff1a\u4e2d\u770b\u4e0d\u4e2d\u7528\u3002</p> <p>\u6211\u8ba4\u4e3a\u53ef\u53d6\u4e4b\u5904</p> <ol> <li>\u8d77\u59cb\u9875\u975e\u5e38\u68d2\uff0c\u628a\u6d4f\u89c8\u5668\u81ea\u5b9a\u4e49\u4e3b\u9875\u4f5c\u4e3a\u535a\u5ba2\u7684\u8d77\u59cb\u9875\uff0c\u505a\u5f97\u7b80\u6d01\u6f02\u4eae\uff0c\u63d0\u4f9bbing\u641c\u7d22\u548cbing\u7ffb\u8bd1\uff0c\u5e94\u8be5\u4f1a\u6709\u4e0d\u5c11\u4eba\u628a\u8be5\u7f51\u7ad9\u5f53\u4f5c\u6d4f\u89c8\u5668\u542f\u52a8\u9875\u9762\u4f7f\u7528\uff0c\u503c\u5f97\u5b66\u4e60\u3002</li> </ol> <p>\u6211\u8ba4\u4e3a\u4e0d\u53ef\u53d6\u4e4b\u5904</p> <ol> <li>\u6807\u7b7e\u6eda\u52a8\u6548\u679c\u662f\u5f88\u70ab\u9177\uff0c\u4f46\u662f\u6ca1\u6709\u4ef7\u503c\uff0c\u9664\u4e86\u65e0\u6cd5\u6ee1\u8db3\u57fa\u672c\u7684\u641c\u7d22\uff0c\u8fde\u6392\u5e8f\u90fd\u4e0d\u80fd\u5b9e\u73b0\u3002\u6807\u7b7e\u7684\u4ef7\u503c\u662f\u4fbf\u4e8e\u67e5\u8be2\uff0c\u4ed6\u8fd9\u6837\u7684\u8bbe\u8ba1\u53ea\u662f\u4e3a\u4e86\u201c\u7f8e\u201d\u3002\u6211\u7684\u7f51\u7ad9\u81f3\u5c11\u53ef\u4ee5<code>Ctrl+F</code>\u5728\u6807\u7b7e\u9875\u641c\u7d22\ud83d\ude05\u3002</li> <li>\u6700\u65b0\u5f39\u5e55\u5bf9\u666e\u901a\u4eba<sup>2</sup>\u800c\u8a00\u6ca1\u6709\u610f\u4e49\uff0c\u70ab\u6280&gt;\u5b9e\u7528\uff0c\u8fd9\u662f\u6211\u7ad9\u5728\u4e00\u4e2a\u5b9e\u7528\u4e3b\u4e49\u8005\uff0c\u56e0\u4e3a\u7f51\u7ad9\u7684\u8bc4\u8bba\u51e0\u4e4e\u5168\u662f\u65e0\u610f\u4e49\u7684\u77ed\u53e5\uff0c\u201c666\u201d\u3001\u201c\u597d\u770b\u201d\u3001\u201c\u5230\u6b64\u4e00\u6e38\u201d\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u4f46\u662f\u7ad9\u5728\u4e00\u4e2a\u9700\u8981\u7f51\u7ad9\u8fbe\u6210\u67d0\u79cd\u76ee\u7684\u7684\u4eba\u800c\u8a00\uff0c\u8be5\u529f\u80fd\u76f8\u5f53\u4e8e\u62fc\u591a\u591a\u5546\u5bb6\u5237\u597d\u8bc4\uff0c\u53ef\u4ee5\u5236\u9020\u51fa\u4eba\u58f0\u9f0e\u6cb8\u4e4b\u52bf\uff0c\u662f\u552c\u4eba\u548c\u903c\u5355\u7684\u597d\u5e2e\u624b\u3002</li> <li>AI\u3001\u767b\u5f55\u529f\u80fd\u3001\u767e\u5b9d\u7bb1\uff0c\u6ca1\u7528\u3002</li> </ol> <p>\u770b\u4e86\u4e8c\u5341\u5206\u949f\u8fd9\u4e2a\u7f51\u7ad9\uff0c\u9760\u56fe\u7247\u6491\u989c\u503c\u3002\u4f46\u662f\u201c\u7f8e\u201d\u662f\u6709\u4ee3\u4ef7\u7684\uff0c\u56fe\u7247\u4f1a\u55a7\u5bbe\u593a\u4e3b\u3002\u5f53\u6211\u89c2\u770b\u4ed6\u7684\u6587\u7ae0\u5217\u8868\u65f6\uff0c\u9664\u4e86\u7b2c\u4e00\u7bc7\u5356\u7f51\u7ad9\u7684\u6587\u7ae0\uff0c\u5176\u4ed6\u6587\u7ae0\u6211\u8fde\u6807\u9898\u90fd\u6ca1\u4ed4\u7ec6\u770b\uff0c\u56e0\u4e3a\u6ce8\u610f\u529b\u771f\u7684\u5f88\u96be\u96c6\u4e2d\u5230\u6587\u5b57\u4e0a\u3002\u5230\u4e8614:10\uff0c\u6211\u552f\u4e00\u8fd8\u8bb0\u5f97\u7684\u5185\u5bb9\u662f\u4e00\u5f20\u5c0f\u5b69\u5149\u5c41\u80a1\u6ce1\u5728\u6c34\u91cc\u7684\u7167\u7247\u3002</p> <p>\u8fd8\u662f\u201c\u5370\u8bb0\u201d\u6700\u987a\u773c\u3002\u8fd9\u662f\u5efa\u7ad9\u591a\u5e74\u7684\u4eba\u624d\u80fd\u5177\u5907\u7684\u5ba1\u7f8e\u3002\u6211\u662f\u5728\u770b\u5230\u4ed6\u5173\u95ed\u4e86\u81ea\u5df1\u7f51\u7ad9\u7684\u201c\u8bc4\u8bba\u201d\u529f\u80fd\u7684\u65f6\u5019\uff0c\u8ba4\u53ef\u4ed6\u4e86\u3002</p> <p>\u4e0b\u9762\u5bf9\u6bd4\u770b\u770b\u4e24\u4e2a\u7f51\u7ad9\u7684\u6807\u7b7e\u662f\u600e\u4e48\u5c55\u793a\u7684\u3002</p> <p></p> <p></p> <p>\u622a\u5c4f\u7559\u4e2a\u5370\u8c61\uff0c\u6d4f\u89c8\u5668\u8d77\u59cb\u6807\u7b7e\u9875+\u4e2a\u4eba\u535a\u5ba2\u771f\u662f\u4e00\u4e2a\u4e0d\u9519\u7684\u7ec4\u5408\u8bbe\u8ba1\u3002\u80fd\u501f\u9274\u5230\u8bb8\u591a\u573a\u666f\u4e2d\u3002</p> <p></p> <p>14:34 \u4e0b\u697c\u6574\u70b9\u5403\u7684\u3002</p> <p>\u5176\u5b9e\u6211\u8fd9\u79cd\u535a\u5ba2\u624d\u662f\u6700\u9700\u8981AI\u529f\u80fd\u7684\u3002\u6bcf\u7bc7\u6587\u7ae0\u7684\u6807\u9898\u90fd\u662f\u5f53\u5929\u65e5\u671f\uff0c\u8bfb\u8005\u80fd\u770b\u5230\u4ec0\u4e48\u5185\u5bb9\uff0c\u8ddf\u62bd\u5956\u6ca1\u533a\u522b\uff0c\u5168\u5c4f\u7ffb\u5230\u54ea\u5929\u505a\u4e3b\u3002</p> <p>\u529f\u80fd\u4f7f\u7528\u573a\u666f\u8bbe\u60f3\uff1a\u8bfb\u8005\u8fdb\u5165\u6211\u7684\u7f51\u7ad9\u540e\u5148\u544a\u8bc9AI\u201c\u81ea\u5df1\u60f3\u770b\u4ec0\u4e48\u201d\uff0c\u7136\u540eAI\u5f00\u59cb\u5de5\u4f5c\u2014\u2014\u5c06\u76f8\u5173\u7684\u6587\u7ae0\u5206\u7c7b\u3001\u6574\u7406\uff0c\u63d0\u4f9b\u6587\u7ae0\u5728\u65b0\u7a97\u53e3\u6253\u5f00\u7684\u94fe\u63a5\u5e76\u7b80\u8981\u6982\u8ff0\u76f8\u5173\u7684\u5185\u5bb9\uff0c\u6700\u7ec8\u4ee5\u8868\u683c\u6216\u5217\u8868\u7684\u5f62\u5f0f\u56de\u7b54\u3002</p> <p>\u8bbe\u8ba1\u8fd9\u79cd\u529f\u80fd\u5e94\u8be5\u9700\u8981\u4e00\u53f0\u670d\u52a1\u5668\uff0c\u8003\u8651\u5bf9\u8bdd\u5386\u53f2\u7684\u50a8\u5b58\u548c\u8bfb\u8005\u7684\u4fe1\u606f\u3002\u5982\u6b64\u770b\u6765\uff0c\u4e00\u65e6\u52a0\u5165AI\uff0c\u90a3\u4e48\u767b\u5f55\u529f\u80fd\u5c31\u662f\u5fc5\u5907\u7684\u3002</p> <p>15:05 \u5fc5\u987b\u4e0b\u697c\u5403\u996d\uff0c\u5fc5\u987b\u4e0b\u697c\uff01\u4eca\u5929\u8fd8\u8981\u6253\u626b\u5367\u5ba4\u536b\u751f\u3002</p> <p>\u6211\u89c9\u5f97\u6211\u8fd8\u662f\u4e0d\u4e70\u57df\u540d\u5427\u3002\u4e00\u65e6\u4e70\u4e86\uff0c\u8fd9\u535a\u5ba2\u5c31\u4e5f\u4e0d\u4f1a\u518d\u5199\u4e86\ud83d\ude04\u3002\u6709\u65f6\u5019\u611f\u89c9\u662f\u597d\u4e8b\uff0c\u5b9e\u9645\u4e0d\u4e00\u5b9a\u662f\u597d\u4e8b\uff1b\u611f\u89c9\u662f\u574f\u4e8b\uff0c\u5b9e\u9645\u4e0a\u4e0d\u4e00\u5b9a\u662f\u574f\u4e8b\u3002</p> <p>16:45 \u51fb\u788e\u7f8e\u56fd\u68a6\uff01\u6700\u201c\u7b80\u964b\u201d\u7684\u5e03\u666f\uff0c\u5374\u62cd\u51fa\u4e86\u6700\u4e11\u964b\u7684\u4eba\u6027\uff018.4\u5206\u795e\u4f5c\u300a\u72d7\u9547\u300b\u7b2c11:28\uff1a\u683c\u857e\u4e1d\u540c\u610f\u6c64\u59c6\u7684\u8868\u767d\u540e\uff0c\u6c64\u59c6\u5374\u6ca1\u60f3\u597d\u5982\u4f55\u5e94\u5bf9\u683c\u857e\u4e1d\u7684\u56de\u5e94\u3002</p> <p>\u542f\u53d1\uff1a\u806a\u660e\u4eba\u505a\u4e8b\u5e94\u5f53\u505a\u9884\u6848\u3002</p> <p>20:21 \u968f\u8bb0APP\uff1a\u65b0\u589e\u4e24\u4e2a\u5feb\u6377\u529f\u80fd<sup>3</sup>\u3001\u4e24\u4e2a\u64cd\u4f5c<sup>4</sup>\u5f97\u5230\u4e86\u4f18\u5316\u3002</p> <p>\u4eca\u5929\u4f7f\u7528\u7684\u6a21\u578b\u662fMiniMax-M3\uff0cDeepSeek-v4-Pro\u88ab\u964d\u667a\u4e86\u3002</p>","tags":["tool-mkdocs"],"boost":1},{"location":"2026/06/2026-06-08/#_3","title":"\u811a\u6ce8","text":"<ol> <li> <p>26.11\uff0c26.10\uff0c26.9 \u21a9</p> </li> <li> <p>\u7279\u6307\u6ca1\u6709\u5546\u4e1a\u53d8\u73b0\u7684\u76ee\u7684\uff0c\u4ec5\u4e3a\u5a31\u4e50\u800c\u642d\u5efa\u7f51\u7ad9\u7684\u4eba\u3002\u00a0\u21a9</p> </li> <li> <p>\u5feb\u6377\u65b9\u5f0f\u3001\u5feb\u6377\u78c1\u94c1\u3002\u00a0\u21a9</p> </li> <li> <p>\u7f16\u8f91\u754c\u9762\u7a7a\u767d\u533a\u57df\u4e5f\u53ef\u89e6\u53d1\u8f93\u5165\u6cd5\u3001\u4e3b\u754c\u9762\u6ed1\u52a8\u7075\u654f\u5ea6\u63d0\u5347\u3002\u00a0\u21a9</p> </li> </ol>","tags":["tool-mkdocs"],"boost":1}]}